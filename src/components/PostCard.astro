---
import { resourceTypeLabel } from "../utils/resources";

interface Props {
  post: {
    id: string;
    title: string;
    slug: string;
    exam: string;
    subject: string;
    chapter?: string;
    resource_type?: string;
    academic_year?: string;
    content?: string;
    image_url?: string;
    image_alt?: string;
    created_at?: string;
  };
  variant?: "grid" | "list";
}

const { post, variant = "grid" } = Astro.props;

const postUrl = `/${post.exam?.toLowerCase()}/${post.subject?.toLowerCase()}/${post.slug}`;
const excerpt =
  (post.content || "").slice(0, 120) +
  ((post.content || "").length > 120 ? "..." : "");
const imageUrl = post.image_url?.trim();
const imageAlt = post.image_alt?.trim() || post.title;
const downloadUrl = `/download?id=${post.id}`;
const metaBits = [post.exam, post.subject, post.academic_year].filter(Boolean);

// A short, human subject code for the mock paper header — real field only.
const subjectCode = (post.subject || "")
  .replace(/[^a-z0-9]/gi, "")
  .slice(0, 4)
  .toUpperCase()
  .padEnd(4, "0");
const resourceLabel = resourceTypeLabel(post.resource_type);
---

{
  variant === "grid" ? (
    <article class="resource-card glass-card">
      <div class="card-tags">
        {post.exam && (
          <span class="omr-bubble filled" title={post.exam}>
            <span class="bubble-mark" />
            <span class="bubble-label">{post.exam}</span>
          </span>
        )}
        {post.subject && (
          <span class="omr-bubble outline" title={post.subject}>
            <span class="bubble-mark" />
            <span class="bubble-label">{post.subject}</span>
          </span>
        )}
      </div>

      <a href={postUrl} class="card-visual" aria-label={post.title}>
        {imageUrl ? (
          <img src={imageUrl} alt={imageAlt} loading="lazy" />
        ) : (
          <div class="paper-header">
            <div class="paper-code">
              <span class="paper-code__label">CODE</span>
              <span class="paper-code__value num">{subjectCode}</span>
            </div>
            <div class="paper-title">{post.subject || post.exam}</div>
            <div class="paper-meta">
              {post.academic_year && <span class="num">{post.academic_year}</span>}
              {post.academic_year && <span class="paper-dot">·</span>}
              <span class="paper-type">{resourceLabel}</span>
            </div>
          </div>
        )}
      </a>

      <div class="card-body">
        <h3 class="card-title">
          <a href={postUrl}>{post.title}</a>
        </h3>
        {excerpt && <p class="card-desc">{excerpt}</p>}
        <div class="card-actions">
          <a href={postUrl} class="btn btn-sm btn-ghost-card">
            পড়ুন
          </a>
          <a href={downloadUrl} class="btn btn-sm btn-download">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3v12" />
              <path d="M7 10l5 5 5-5" />
              <path d="M5 21h14" />
            </svg>
            ডাউনলোড
          </a>
        </div>
      </div>
    </article>
  ) : (
    <a href={postUrl} class="recent-item glass-card">
      <span class="recent-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 3h7l5 5v12a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z" />
          <path d="M13 3v5h5" />
        </svg>
      </span>
      <div class="recent-info">
        <span class="recent-title">{post.title}</span>
        <span class="recent-meta num">{metaBits.join(" · ")}</span>
      </div>
    </a>
  )
}

<style>
  .resource-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.1rem;
  }
  .card-tags {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  /* OMR bubble markers — exam = filled ●, subject = outline ○ */
  .omr-bubble {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    background: var(--bg-surface-raised);
    color: var(--text-secondary);
    border: 1px solid var(--border-hairline);
  }
  .omr-bubble .bubble-mark {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid var(--text-muted);
    flex-shrink: 0;
  }
  .omr-bubble.filled {
    color: var(--accent-primary);
    border-color: var(--accent-primary-soft);
  }
  .omr-bubble.filled .bubble-mark {
    background: var(--accent-primary);
    border-color: var(--accent-primary);
  }
  .omr-bubble.outline .bubble-mark { background: transparent; }

  /* Mock exam-paper-header thumbnail replacing the blank "PDF" box.
     Real fields only — no fabricated page/question counts. */
  .card-visual {
    display: flex;
    align-items: stretch;
    justify-content: center;
    min-height: 150px;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-base);
    border: 1px solid var(--border-hairline);
    text-decoration: none;
    color: var(--text-primary);
    position: relative;
  }
  /* subtle grid-paper texture, felt not seen */
  .card-visual::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 14px 14px;
    pointer-events: none;
  }
  .card-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .paper-header {
    width: 100%;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    justify-content: center;
    position: relative;
    z-index: 1;
  }
  .paper-code {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .paper-code__label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .paper-code__value {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--accent-primary);
  }
  .paper-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    text-transform: capitalize;
    color: var(--text-primary);
    line-height: 1.3;
  }
  .paper-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    color: var(--text-muted);
  }
  .paper-meta .num { color: var(--text-secondary); }
  .paper-dot { color: var(--text-muted); }
  .paper-type { text-transform: capitalize; }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .card-title {
    font-size: 1.02rem;
    line-height: 1.45;
  }
  .card-title a {
    color: var(--text-primary);
    text-decoration: none;
  }
  .card-title a:hover { color: var(--accent-primary); }
  .card-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.65;
  }
  .card-actions {
    display: flex;
    gap: 0.55rem;
    margin-top: 0.15rem;
  }
  .btn-sm {
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius);
    font-size: 0.86rem;
  }
  .btn-ghost-card {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border-hairline);
    flex: 1;
  }
  .btn-ghost-card:hover { border-color: var(--accent-primary); background: var(--bg-surface-raised); }
  /* Download is consistently teal across all cards */
  .btn-download {
    background: var(--accent-secondary);
    color: #052015;
    border: 1px solid var(--accent-secondary);
    flex: 1;
  }
  .btn-download:hover {
    background: var(--color-success-strong);
    border-color: var(--color-success-strong);
    color: #052015;
  }

  .recent-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.85rem 1rem;
    text-decoration: none;
    color: var(--text-primary);
  }
  .recent-icon {
    width: 38px;
    height: 38px;
    border-radius: var(--radius);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-surface-raised);
    color: var(--accent-primary);
    flex-shrink: 0;
  }
  .recent-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .recent-title {
    font-weight: 600;
    color: var(--text-primary);
  }
  .recent-meta {
    font-size: 0.78rem;
    color: var(--text-muted);
  }
</style>
