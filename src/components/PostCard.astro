---
import { resourceTypeLabel } from "../utils/resources";

interface Props {
  post: {
    id: string;
    title: string;
    slug: string;
    exam: string;
    subject: string;
    chapter?: string;
    resource_type?: string;
    academic_year?: string;
    content?: string;
    image_url?: string;
    image_alt?: string;
    created_at?: string;
  };
  variant?: "grid" | "list";
}

const { post, variant = "grid" } = Astro.props;

const postUrl = `/${post.exam?.toLowerCase()}/${post.subject?.toLowerCase()}/${post.slug}`;
const excerpt =
  (post.content || "").slice(0, 110) +
  ((post.content || "").length > 110 ? "..." : "");
const imageUrl = post.image_url?.trim();
const imageAlt = post.image_alt?.trim() || post.title;
const downloadUrl = `/download?id=${post.id}`;

const resourceLabel = resourceTypeLabel(post.resource_type);

// Exam-paper top margin: subject code + roll-style ID, mono.
const subjectCode = (post.subject || "PDF").slice(0, 4).toUpperCase();
const paperCode = [post.exam?.toUpperCase(), subjectCode].filter(Boolean).join(" / ");
const paperYear = post.academic_year || "PDF";
const rollNo = (post.id || "").replace(/[^0-9a-zA-Z]/g, "").slice(-5).toUpperCase() || "0000";

const metaLine = [post.exam, post.subject, post.academic_year].filter(Boolean);
---

{
  variant === "grid" ? (
    <article class="exam-card">
      <a href={postUrl} class="paper-strip" aria-label={post.title}>
        <span class="strip-code">{paperCode}</span>
        <span class="muted">{paperYear}</span>
      </a>

      <div class="card-body">
        <div class="card-meta mono">
          <span class="omr filled" aria-hidden="true"></span>
          <span>{resourceLabel}</span>
          <span class="meta-sep">/</span>
          <span>ROLL {rollNo}</span>
        </div>

        {imageUrl ? (
          <img src={imageUrl} alt={imageAlt} loading="lazy" class="card-image" />
        ) : null}

        <h3 class="card-title">
          <a href={postUrl}>{post.title}</a>
        </h3>
        {excerpt && <p class="card-desc">{excerpt}</p>}

        <div class="card-actions">
          <a href={postUrl} class="btn-text">পড়ুন</a>
          <a href={downloadUrl} class="btn btn-primary btn-sm">ফাইল লিংক →</a>
        </div>
      </div>
    </article>
  ) : (
    <a href={postUrl} class="recent-item">
      <span class="omr filled" aria-hidden="true"></span>
      <div class="recent-info">
        <span class="recent-title">{post.title}</span>
        <span class="recent-meta mono">{metaLine.join(" · ")}</span>
      </div>
    </a>
  )
}

<style>
  .exam-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg-surface);
  }
  .exam-card .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1rem 1.1rem 1.1rem;
    flex: 1;
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .card-meta .meta-sep { color: var(--border-strong); }
  .card-image {
    width: 100%;
    height: 150px;
    object-fit: cover;
    display: block;
    border: 1px solid var(--border-hairline);
  }
  .card-title {
    font-size: 1.02rem;
    line-height: 1.45;
  }
  .card-title a {
    color: var(--text-primary);
    text-decoration: none;
  }
  .card-title a:hover { color: var(--accent); }
  .card-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.65;
  }
  .card-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    border-top: 1px solid var(--border-hairline);
    padding-top: 0.7rem;
  }

  .recent-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.85rem 0.4rem;
    text-decoration: none;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-hairline);
  }
  .recent-item:hover { background: var(--bg-surface-raised); }
  .recent-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .recent-title { font-weight: 600; color: var(--text-primary); }
  .recent-meta {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>
