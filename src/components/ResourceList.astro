---
import { resourceTypeLabel } from "../utils/resources";
import { resourcePath, displayLabel } from "../utils/hubs";

interface Props {
  posts: Array<Record<string, any>>;
  emptyMessage?: string;
}

const { posts = [], emptyMessage = "এই মুহূর্তে কোনো PDF পাওয়া যায়নি।" } = Astro.props;
---

{
  posts.length === 0 ? (
    <div class="empty-stamp">
      <span class="stamp-word">খালি</span>
      <p>{emptyMessage}</p>
      <span class="mono">STATUS: NO_DOCUMENTS</span>
    </div>
  ) : (
    <div class="ledger-grid">
      {posts.map((post) => {
        const href = resourcePath(post.exam, post.subject, post.slug);
        const subjectCode = (post.subject || "PDF").slice(0, 4).toUpperCase();
        const paperCode = [post.exam?.toUpperCase(), subjectCode].filter(Boolean).join(" / ");
        const meta = [
          displayLabel(post.subject),
          post.chapter ? displayLabel(post.chapter) : null,
          resourceTypeLabel(post.resource_type),
        ].filter(Boolean);
        return (
          <article class="hub-resource-card">
            <a href={href} class="paper-strip">
              <span class="strip-code">{paperCode}</span>
              <span class="muted">{post.academic_year || "PDF"}</span>
            </a>
            <div class="hub-card-body">
              <span class="hub-resource-meta mono">
                <span class="omr filled" aria-hidden="true"></span>
                <span>{meta.join(" / ")}</span>
              </span>
              <h3>
                <a href={href} class="hub-resource-link">{post.title}</a>
              </h3>
              <div class="hub-resource-actions">
                <a href={href} class="btn-text">পড়ুন</a>
                <a href={`/download?id=${post.id}`} class="btn btn-primary btn-sm">
                  ডাউনলোড ↓
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  )
}

<style>
  .hub-resource-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg-surface);
  }
  .hub-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1rem 1.1rem 1.1rem;
    flex: 1;
  }
  .hub-resource-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .hub-resource-link {
    text-decoration: none;
    color: var(--text-primary);
    font-size: 1.05rem;
    line-height: 1.45;
  }
  .hub-resource-link:hover { color: var(--accent); }
  .hub-resource-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    border-top: 1px solid var(--border-hairline);
    padding-top: 0.7rem;
  }
</style>
