---
interface Props {
  appUrl?: string;
  searchQuery?: string;
  showSearch?: boolean;
  showBackLink?: boolean;
}

const {
  appUrl = "https://web.prostuti.bd",
  searchQuery = "",
  showSearch = true,
  showBackLink = false,
} = Astro.props;
---

<nav class="nav-bar" id="main-nav">
  <div class="nav-container">
    <a href="/" class="logo">
      <svg class="logo-mark" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 3.5h9l5 5V20a.5.5 0 0 1-.5.5h-13A.5.5 0 0 1 5 20V3.5Z" />
        <path d="M14 3.5V8.5h5" />
        <circle cx="9" cy="13" r="0.9" fill="currentColor" stroke="none" />
        <circle cx="12" cy="13" r="0.9" fill="currentColor" stroke="none" />
        <circle cx="15" cy="13" r="0.9" fill="currentColor" stroke="none" />
      </svg>
      <span class="logo-text"
        >প্রস্তুতি <span class="accent-text">BD</span></span
      >
    </a>

    {
      showSearch && (
        <form class="nav-search" method="GET" action="/">
          <input
            type="search"
            name="search"
            value={searchQuery}
            placeholder="পিডিএফ, সাজেশন, বিষয়"
            aria-label="Search PDFs"
          />
          <button type="submit" aria-label="খুঁজুন">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <line x1="16.5" y1="16.5" x2="21" y2="21" />
            </svg>
          </button>
        </form>
      )
    }

    <div class="nav-actions">
      <button
        class="theme-toggle"
        id="theme-toggle"
        type="button"
        aria-label="Toggle theme"
      >
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" />
          <line x1="12" y1="2" x2="12" y2="4" /><line x1="12" y1="20" x2="12" y2="22" />
          <line x1="2" y1="12" x2="4" y2="12" /><line x1="20" y1="12" x2="22" y2="12" />
          <line x1="4.9" y1="4.9" x2="6.3" y2="6.3" /><line x1="17.7" y1="17.7" x2="19.1" y2="19.1" />
          <line x1="4.9" y1="19.1" x2="6.3" y2="17.7" /><line x1="17.7" y1="6.3" x2="19.1" y2="4.9" />
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" />
        </svg>
      </button>
      {
        showBackLink && (
          <a href="/" class="back-link">
            হোম
          </a>
        )
      }
      <a href={appUrl} class="app-btn-nav" target="_blank" rel="noopener"
        >অ্যাপ</a
      >
    </div>

    <button
      class="hamburger"
      id="hamburger-btn"
      aria-label="মেনু খুলুন"
      aria-expanded="false"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    {
      showSearch && (
        <form class="mobile-search" method="GET" action="/">
          <input
            type="search"
            name="search"
            value={searchQuery}
            placeholder="পিডিএফ, সাজেশন, বিষয়"
            aria-label="Search PDFs"
          />
          <button type="submit" aria-label="খুঁজুন">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <line x1="16.5" y1="16.5" x2="21" y2="21" />
            </svg>
          </button>
        </form>
      )
    }
    {
      showBackLink && (
        <a href="/" class="mobile-menu-link">
          ← হোমপেজে ফিরুন
        </a>
      )
    }
    <a href={appUrl} class="mobile-menu-link" target="_blank" rel="noopener">অ্যাপ ওপেন করুন</a>
    <a href="/#suggestions" class="mobile-menu-link">পিডিএফ খুঁজুন</a>
    <a href="/#categories" class="mobile-menu-link">ক্যাটাগরি ব্রাউজ করুন</a>
  </div>
</nav>

<style>
  .nav-bar {
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(18px);
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    border-bottom: 1px solid var(--border-soft);
  }
  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.9rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    white-space: nowrap;
  }
  .logo-mark {
    color: var(--accent-primary);
    flex-shrink: 0;
  }
  .accent-text {
    color: var(--accent-primary);
    font-family: var(--font-mono);
    font-size: 0.85em;
    letter-spacing: 0.02em;
  }
  .nav-search {
    flex: 1;
    max-width: 520px;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.4rem 0.35rem 0.65rem;
    background: var(--surface-muted);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius);
  }
  .nav-search input {
    width: 100%;
    border: none;
    outline: none;
    background: transparent;
    color: var(--text-primary);
    padding: 0.4rem 0.2rem;
  }
  .nav-search input::placeholder {
    color: var(--text-muted);
  }
  .nav-search button,
  .mobile-search button,
  .theme-toggle {
    border: 1px solid transparent;
    border-radius: var(--radius);
    width: 2.1rem;
    height: 2.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-surface-raised);
    color: var(--text-primary);
    cursor: pointer;
  }
  .nav-search button:hover,
  .mobile-search button:hover,
  .theme-toggle:hover {
    border-color: var(--border-hairline);
  }
  .theme-toggle { position: relative; }
  .theme-toggle .icon-moon { display: none; }
  [data-theme='dark'] .theme-toggle .icon-sun { display: none; }
  [data-theme='dark'] .theme-toggle .icon-moon { display: inline-flex; }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .back-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .back-link:hover { color: var(--text-primary); }
  .app-btn-nav {
    text-decoration: none;
    color: #fff;
    background: var(--accent-primary);
    padding: 0.55rem 0.95rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .app-btn-nav:hover { background: var(--color-primary-strong); }
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 0.5rem;
    border: 1px solid var(--border-hairline);
    background: var(--bg-surface-raised);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .hamburger-line {
    width: 18px;
    height: 2px;
    background: var(--text-primary);
    border-radius: 2px;
  }
  .hamburger[aria-expanded="true"] .hamburger-line:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  .hamburger[aria-expanded="true"] .hamburger-line:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
  .mobile-menu {
    display: none;
    flex-direction: column;
    gap: 0.7rem;
    padding: 0 1.25rem 1rem;
    border-top: 1px solid var(--border-soft);
  }
  .mobile-menu.open {
    display: flex;
  }
  .mobile-search {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.4rem 0.35rem 0.65rem;
    background: var(--surface-muted);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius);
    margin-top: 0.8rem;
  }
  .mobile-search input {
    width: 100%;
    border: none;
    outline: none;
    background: transparent;
    color: var(--text-primary);
    padding: 0.4rem;
  }
  .mobile-menu-link {
    display: block;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.75rem 0.5rem;
    font-size: 0.95rem;
    font-weight: 500;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    transition: color 0.2s;
  }
  .mobile-menu-link:hover {
    color: var(--color-primary);
  }
  @media (max-width: 820px) {
    .nav-search {
      display: none;
    }
    .nav-actions .back-link,
    .nav-actions .app-btn-nav {
      display: none;
    }
    .hamburger {
      display: inline-flex;
    }
  }
</style>

<script>
  const toggle = document.getElementById(
    "theme-toggle",
  ) as HTMLButtonElement | null;
  const menuButton = document.getElementById(
    "hamburger-btn",
  ) as HTMLButtonElement | null;
  const menu = document.getElementById("mobile-menu");

  const setTheme = (theme: string) => {
    document.documentElement.setAttribute("data-theme", theme);
    document.documentElement.style.colorScheme = theme;
    localStorage.setItem("prostuti-theme", theme);
  };

  const currentTheme =
    localStorage.getItem("prostuti-theme") ||
    (window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light");
  setTheme(currentTheme);

  if (toggle) {
    toggle.addEventListener("click", () => {
      const nextTheme =
        document.documentElement.getAttribute("data-theme") === "dark"
          ? "light"
          : "dark";
      setTheme(nextTheme);
    });
  }

  if (menuButton && menu) {
    menuButton.addEventListener("click", () => {
      const expanded = menuButton.getAttribute("aria-expanded") === "true";
      menuButton.setAttribute("aria-expanded", String(!expanded));
      menu.classList.toggle("open");
    });

    document.addEventListener("click", (event: MouseEvent) => {
      const target = event.target as Node | null;
      if (target && !menuButton.contains(target) && !menu.contains(target)) {
        menuButton.setAttribute("aria-expanded", "false");
        menu.classList.remove("open");
      }
    });
  }
</script>
