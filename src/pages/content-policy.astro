---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const title = "কনটেন্ট নীতি (Content Policy)";
const description =
  "Prostuti BD-তে কোন ধরনের PDF প্রকাশযোগ্য, সোর্স/লাইসেন্স নিয়ম এবং আর্কাইভ নীতি।";
---

<BaseLayout title={title} description={description} canonicalPath="/content-policy" pageType="website">
  <Navbar showSearch={false} showBackLink={true} />
  <main class="container legal-page">
    <article class="glass-card legal-card">
      <h1>{title}</h1>
      <p class="legal-updated">সর্বশেষ আপডেট: ২৯ জুলাই ২০২৬</p>

      <section>
        <h2>১. কী প্রকাশ করা হয়</h2>
        <ul>
          <li>HSC, Admission ও BCS (এবং প্রয়োজনে SSC) শিক্ষামূলক PDF।</li>
          <li>নিজস্ব বা লিখিত/স্পষ্ট অনুমোদিত কনটেন্ট।</li>
          <li>প্রতিটি রিসোর্সে বিষয়, অধ্যায়, বছর, টাইপ, সোর্স ও লাইসেন্স মেটাডেটা।</li>
        </ul>
      </section>

      <section>
        <h2>২. কী প্রকাশ করা হয় না</h2>
        <ul>
          <li>পাইরেটেড বই, লিক হওয়া প্রশ্নপত্র বা অস্পষ্ট অধিকারের ফাইল।</li>
          <li>বিভ্রান্তিকর “১০০% গ্যারান্টি” দাবি ছাড়া যাচাইবিহীন মার্কেটিং স্প্যাম।</li>
          <li>ঘৃণা, হয়রানি বা আইনবিরোধী কনটেন্ট।</li>
        </ul>
      </section>

      <section>
        <h2>৩. সম্পাদকীয় ওয়ার্কফ্লো</h2>
        <p>
          আপলোড → মেটাডেটা/SEO → অধিকার যাচাই → প্রিভিউ → পাবলিশ → মাসিক রিফ্রেশ। পুরনো বা
          ভুল PDF আর্কাইভ বা প্রতিস্থাপন করা হয়।
        </p>
      </section>

      <section>
        <h2>৪. Takedown</h2>
        <p>
          অধিকারধারী বা ব্যবহারকারী <a href="/report">রিপোর্ট ফর্ম</a> দিয়ে অভিযোগ জানাতে
          পারেন। বৈধ অনুরোধে রিসোর্স সরিয়ে নেওয়া বা সংশোধন করা হবে।
        </p>
      </section>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .legal-page { padding: 1.5rem 0 3rem; max-width: 820px; }
  .legal-card { padding: 1.6rem 1.4rem; display: grid; gap: 1.25rem; }
  .legal-card h1 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .legal-updated { color: var(--text-muted); font-size: 0.9rem; }
  .legal-card h2 { font-size: 1.1rem; margin-bottom: 0.45rem; }
  .legal-card p, .legal-card li { color: var(--text-secondary); line-height: 1.75; }
  .legal-card ul { padding-left: 1.2rem; display: grid; gap: 0.4rem; }
  .legal-card a { color: var(--color-primary); }
</style>
