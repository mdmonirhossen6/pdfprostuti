---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const title = "ব্যবহারের শর্তাবলি (Terms of Use)";
const description =
  "Prostuti BD ওয়েবসাইট ও PDF লাইব্রেরি ব্যবহারের শর্তাবলি। অনুমোদিত কনটেন্ট, ডাউনলোড ও দায়িত্ব সম্পর্কে জানুন।";
---

<BaseLayout title={title} description={description} canonicalPath="/terms" pageType="website">
  <Navbar showSearch={false} showBackLink={true} />
  <main class="container legal-page">
    <article class="glass-card legal-card">
      <h1>{title}</h1>
      <p class="legal-updated">সর্বশেষ আপডেট: ২৯ জুলাই ২০২৬</p>

      <section>
        <h2>১. সেবার পরিচিতি</h2>
        <p>
          Prostuti BD (prostutibd.app) বাংলাদেশের শিক্ষার্থীদের জন্য অনুমোদিত PDF, নোট,
          সাজেশন ও পরীক্ষা প্রস্তুতি রিসোর্সের discovery প্ল্যাটফর্ম। সাইট ব্যবহার করে আপনি এই
          শর্তাবলিতে সম্মত হচ্ছেন।
        </p>
      </section>

      <section>
        <h2>২. অনুমোদিত ব্যবহার</h2>
        <ul>
          <li>ব্যক্তিগত শিক্ষা ও পরীক্ষা প্রস্তুতির জন্য PDF ডাউনলোড ও ব্যবহার করা যাবে।</li>
          <li>বাণিজ্যিক পুনঃবিক্রয়, অননুমোদিত পুনঃপ্রকাশ বা স্ক্র্যাপিং নিষিদ্ধ।</li>
          <li>অ্যাডমিন এলাকা ও সিস্টেম নিরাপত্তা ভঙ্গের চেষ্টা নিষিদ্ধ।</li>
        </ul>
      </section>

      <section>
        <h2>৩. কনটেন্ট ও অধিকার</h2>
        <p>
          আমরা শুধু নিজস্ব বা অনুমোদিত/লাইসেন্সকৃত কনটেন্ট প্রকাশ করি। তৃতীয় পক্ষের কপিরাইট
          লঙ্ঘন হলে <a href="/report">রিপোর্ট পেজ</a> থেকে জানান—দ্রুত পর্যালোচনা করে
          সরিয়ে নেওয়া হবে।
        </p>
      </section>

      <section>
        <h2>৪. অ্যাপ CTA ও বাহ্যিক লিংক</h2>
        <p>
          সাইট থেকে <a href="https://web.prostuti.bd" target="_blank" rel="noopener">web.prostuti.bd</a>
          এবং টেলিগ্রাম/ড্রাইভের মতো বাহ্যিক সেবায় লিংক থাকতে পারে। সেসব প্ল্যাটফর্মের নিজস্ব
          নীতি প্রযোজ্য।
        </p>
      </section>

      <section>
        <h2>৫. দায় সীমাবদ্ধতা</h2>
        <p>
          শিক্ষামূলক সহায়তার জন্য রিসোর্স সরবরাহ করা হয়; নির্দিষ্ট পরীক্ষার ফলাফলের গ্যারান্টি
          দেওয়া হয় না। সেবা “যেমন আছে” ভিত্তিতে দেওয়া হয়।
        </p>
      </section>

      <section>
        <h2>৬. যোগাযোগ</h2>
        <p>প্রশ্ন থাকলে <a href="/report">রিপোর্ট / যোগাযোগ</a> পেজ ব্যবহার করুন।</p>
      </section>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .legal-page { padding: 1.5rem 0 3rem; max-width: 820px; }
  .legal-card { padding: 1.6rem 1.4rem; display: grid; gap: 1.25rem; }
  .legal-card h1 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .legal-updated { color: var(--text-muted); font-size: 0.9rem; }
  .legal-card h2 { font-size: 1.1rem; margin-bottom: 0.45rem; }
  .legal-card p, .legal-card li { color: var(--text-secondary); line-height: 1.75; }
  .legal-card ul { padding-left: 1.2rem; display: grid; gap: 0.4rem; }
  .legal-card a { color: var(--color-primary); }
</style>
