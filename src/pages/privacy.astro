---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const title = "গোপনীয়তা নীতি (Privacy Policy)";
const description =
  "Prostuti BD কীভাবে অ্যাডমিন অথেন্টিকেশন, অ্যানালিটিক্স ও ডাউনলোড-সংক্রান্ত তথ্য পরিচালনা করে তা জানুন।";
---

<BaseLayout title={title} description={description} canonicalPath="/privacy" pageType="website">
  <Navbar showSearch={false} showBackLink={true} />
  <main class="container legal-page">
    <article class="glass-card legal-card">
      <h1>{title}</h1>
      <p class="legal-updated">সর্বশেষ আপডেট: ২৯ জুলাই ২০২৬</p>

      <section>
        <h2>১. আমরা কী সংগ্রহ করি</h2>
        <ul>
          <li>পাবলিক ব্রাউজিং: সাধারণ সার্ভার/CDN লগ (IP, ইউজার-এজেন্ট, পেজ ভিউ)।</li>
          <li>অ্যাডমিন: লগইন কুকি (`admin_token`) — শুধু কনটেন্ট ম্যানেজমেন্টের জন্য।</li>
          <li>রিপোর্ট ফর্ম: আপনি স্বেচ্ছায় দেওয়া ইমেইল ও বার্তা।</li>
        </ul>
      </section>

      <section>
        <h2>২. শিক্ষার্থী অ্যাকাউন্ট</h2>
        <p>
          বর্তমান সংস্করণে পাবলিক স্টুডেন্ট অ্যাকাউন্ট, বুকমার্ক বা অ্যাপ SSO নেই। পরে যোগ
          হলে এই নীতি আপডেট করা হবে।
        </p>
      </section>

      <section>
        <h2>৩. কুকি ও অ্যানালিটিক্স</h2>
        <p>
          থিম পছন্দ লোকাল স্টোরেজে রাখা হতে পারে। Google Search Console, GA4 বা Cloudflare
          Analytics ব্যবহার হলে অ্যাগ্রিগেটেড ট্রাফিক পরিমাপ করা হয়—মার্কেটিং প্রোফাইলিং নয়।
        </p>
      </section>

      <section>
        <h2>৪. তৃতীয় পক্ষ</h2>
        <p>
          ফাইল হোস্টিং (Supabase Storage), CDN (Cloudflare) এবং অ্যাপ (`web.prostuti.bd`) তৃতীয়
          পক্ষের অবকাঠামো ব্যবহার করে। তাদের নিজস্ব গোপনীয়তা নীতি প্রযোজ্য।
        </p>
      </section>

      <section>
        <h2>৫. আপনার অধিকার</h2>
        <p>
          রিপোর্ট বা ডেটা সম্পর্কিত অনুরোধ জানাতে <a href="/report">রিপোর্ট পেজ</a> ব্যবহার
          করুন। আমরা যুক্তিসঙ্গত সময়ের মধ্যে সাড়া দেব।
        </p>
      </section>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .legal-page { padding: 1.5rem 0 3rem; max-width: 820px; }
  .legal-card { padding: 1.6rem 1.4rem; display: grid; gap: 1.25rem; }
  .legal-card h1 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .legal-updated { color: var(--text-muted); font-size: 0.9rem; }
  .legal-card h2 { font-size: 1.1rem; margin-bottom: 0.45rem; }
  .legal-card p, .legal-card li { color: var(--text-secondary); line-height: 1.75; }
  .legal-card ul { padding-left: 1.2rem; display: grid; gap: 0.4rem; }
  .legal-card a { color: var(--color-primary); }
</style>
