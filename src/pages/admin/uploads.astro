---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminNav from '../../components/admin/AdminNav.astro';
import { verifyAuth } from '../../utils/auth';
import { uploadAsset } from '../../utils/storage';

const runtime = Astro.locals.runtime;
if (!(await verifyAuth(Astro.cookies, runtime))) {
  return Astro.redirect('/admin/login');
}

let errorMessage = '';
let uploadedFile = null;

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    uploadedFile = await uploadAsset({
      runtime,
      file: formData.get('pdf_file'),
      folder: 'pdfs',
      kind: 'pdf',
    });
    if (!uploadedFile) errorMessage = 'Select a PDF file before uploading.';
  } catch (error) {
    errorMessage = error instanceof Error ? error.message : 'The file could not be uploaded.';
  }
}
---

<BaseLayout title="PDF Library · Prostuti BD Admin">
  <AdminNav badge="PDF Library" backTo="/admin" backLabel="← Dashboard" />

  <main class="page-shell">
    <section class="intro">
      <p class="eyebrow">Resource management</p>
      <h1>Upload a PDF once, then attach it to any post.</h1>
      <p>Files are stored in your configured Supabase Storage bucket. The returned public link can be pasted into a post or shared with your team.</p>
    </section>

    {errorMessage && <div class="notice error">{errorMessage}</div>}
    {uploadedFile && (
      <section class="result-card">
        <div class="success-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
        <div>
          <p class="eyebrow">Upload complete</p>
          <h2>Your PDF is ready to use.</h2>
          <input id="uploaded-url" value={uploadedFile.url} readonly aria-label="Uploaded PDF link" />
          <div class="result-actions">
            <button id="copy-url" type="button">Copy link</button>
            <a href={`/admin/edit?file_url=${encodeURIComponent(uploadedFile.url)}`}>Create a resource post →</a>
          </div>
        </div>
      </section>
    )}

    <form method="POST" enctype="multipart/form-data" class="upload-card">
      <label class="upload-target" for="pdf_file">
        <span class="upload-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg></span>
        <strong>Choose a PDF file</strong>
        <span>PDF files only · maximum 25 MB</span>
      </label>
      <input id="pdf_file" name="pdf_file" type="file" accept="application/pdf,.pdf" required />
      <button type="submit">Upload PDF</button>
    </form>

    <p class="help">For a complete post with a cover, SEO metadata, and download settings, use the <a href="/admin/edit">content editor</a>. It also supports uploading PDFs directly while saving.</p>
  </main>
</BaseLayout>

<script>
  document.getElementById('copy-url')?.addEventListener('click', async () => {
    const input = document.getElementById('uploaded-url') as HTMLInputElement | null;
    if (!input) return;
    await navigator.clipboard.writeText(input.value);
    const button = document.getElementById('copy-url');
    if (button) button.textContent = 'Copied';
  });
</script>

<style>
  .page-shell { width: min(100% - 2.5rem, 880px); margin: 0 auto; padding: 4rem 0 6rem; }
  .intro { max-width: 640px; margin-bottom: 2rem; }
  .eyebrow { margin-bottom: .55rem; color: var(--accent-primary); font-size: .82rem; font-weight: 600; }
  h1, h2 { line-height: 1.2; color: var(--text-primary); } h1 { font-size: clamp(2rem, 5vw, 3rem); font-family: var(--font-display); } h2 { font-size: 1.4rem; }
  .intro > p:last-child, .help { margin-top: .85rem; color: var(--text-secondary); }
  .upload-card, .result-card { border: 1px solid var(--border-hairline); background: var(--bg-surface); border-radius: var(--radius); padding: 1.4rem; }
  .upload-card { display: grid; gap: 1rem; }
  .upload-target { padding: 2.3rem 1rem; border: 1px dashed var(--border-strong); border-radius: var(--radius); text-align: center; cursor: pointer; display: grid; gap: .3rem; color: var(--text-secondary); }
  .upload-target strong { color: var(--text-primary); font-size: 1.1rem; }.upload-icon { color: var(--accent-primary); font-size: 2rem; line-height: 1; }
  input[type=file] { color: var(--text-secondary); }
  .upload-card button, .result-actions a, .result-actions button { border: 0; border-radius: var(--radius); padding: .8rem 1rem; background: var(--accent-primary); color: #F7F3EA; font-weight: 700; cursor: pointer; text-align: center; text-decoration: none; }
  .result-card { display: flex; gap: 1rem; margin-bottom: 1.25rem; }
  .success-icon { width: 42px; height: 42px; flex: 0 0 42px; border-radius: var(--radius); display: grid; place-items: center; background: var(--accent-primary-soft); color: var(--accent-primary); font-weight: 800; }
  .result-card input { width: 100%; margin-top: 1rem; padding: .75rem; border: 1px solid var(--border-hairline); border-radius: var(--radius); color: var(--text-primary); background: var(--bg-base); }
  .result-actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: .8rem; }
  .result-actions button { background: var(--bg-surface-raised); border: 1px solid var(--border-hairline); color: var(--text-primary); }
  .notice { border-radius: var(--radius); padding: 1rem; margin-bottom: 1.25rem; }
  .error { color: var(--accent-danger); border: 1px solid var(--accent-danger); background: rgba(179, 38, 30, 0.1); }
  .help a { color: var(--accent-primary); }
  @media (max-width: 560px) { .page-shell { width: min(100% - 1.5rem, 880px); padding-top: 2.5rem; } .result-card { display: block; }.success-icon { margin-bottom: .8rem; } }
</style>
