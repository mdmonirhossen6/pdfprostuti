---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminNav from '../../components/admin/AdminNav.astro';
import { verifyAuth, getAdminCredentials } from '../../utils/auth';
import { uploadAsset } from '../../utils/storage';
import { APP_CTA_ORIGIN } from '../../utils/cta';
import {
  LICENSE_OPTIONS,
  RESOURCE_TYPES,
  STATUS_OPTIONS,
  publishedToStatus,
  slugify,
  statusToPublished,
} from '../../utils/resources';

const runtime = Astro.locals.runtime;
const isAuthed = await verifyAuth(Astro.cookies, runtime);

if (!isAuthed) {
  return Astro.redirect('/admin/login');
}

const { dbUrl, dbWriteKey, dbReadKey } = getAdminCredentials(runtime);
const { searchParams } = Astro.url;
const editId = searchParams.get('id');
const uploadedFileUrl = searchParams.get('file_url') || '';

let errorMessage = '';
let successMessage = '';

let postData = {
  title: '',
  slug: '',
  exam: 'HSC',
  subject: '',
  chapter: '',
  resource_type: 'notes',
  academic_year: '',
  license: 'authorized',
  source: '',
  status: 'published',
  content: '',
  ad_text: '',
  image_url: '',
  image_alt: '',
  file_url: '',
  drive_url: '',
  link_type: 'download',
  is_published: true,
  show_app_opener: true,
  app_link: '',
  app_title: '',
  app_description: '',
  app_button_text: '',
  telegram_url: 'https://t.me/hscfreepdf',
  telegram_btn_text: 'টেলিগ্রাম চ্যানেলে জয়েন করুন →',
  seo_title: '',
  meta_description: '',
  focus_keyword: '',
  schema_type: 'Article',
};

if (uploadedFileUrl) {
  postData.file_url = uploadedFileUrl;
}

if (editId) {
  try {
    const res = await fetch(`${dbUrl}/rest/v1/posts?id=eq.${editId}`, {
      headers: { 'apikey': dbReadKey, 'Authorization': `Bearer ${dbReadKey}` }
    });
    if (res.ok) {
      const data = await res.json();
      if (data && data.length > 0) {
        postData = { ...postData, ...data[0] };
        if (!postData.status) {
          postData.status = publishedToStatus(postData.is_published);
        }
      }
    }
  } catch (e) {
    errorMessage = 'সংশ্লিষ্ট পোস্ট লোড করতে সমস্যা হয়েছে।';
  }
}

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();

    const uploadedCover = await uploadAsset({
      runtime,
      file: data.get('cover_image'),
      folder: 'covers',
      kind: 'image'
    });
    const uploadedPdf = await uploadAsset({
      runtime,
      file: data.get('pdf_file'),
      folder: 'pdfs',
      kind: 'pdf'
    });

    const status = data.get('status')?.toString().trim() || 'draft';
    const isPublished = statusToPublished(status);

    const payload = {
      title: data.get('title')?.toString().trim() || '',
      slug: slugify(data.get('slug')?.toString() || data.get('title')?.toString() || ''),
      exam: data.get('exam')?.toString().trim() || 'HSC',
      subject: slugify(data.get('subject')?.toString() || ''),
      chapter: slugify(data.get('chapter')?.toString() || ''),
      resource_type: data.get('resource_type')?.toString().trim() || 'notes',
      academic_year: data.get('academic_year')?.toString().trim() || '',
      license: data.get('license')?.toString().trim() || 'authorized',
      source: data.get('source')?.toString().trim() || '',
      status,
      content: data.get('content')?.toString() || '',
      ad_text: data.get('ad_text')?.toString() || '',
      image_url: uploadedCover?.url || data.get('image_url')?.toString().trim() || '',
      image_alt: data.get('image_alt')?.toString().trim() || '',
      file_url: uploadedPdf?.url || data.get('file_url')?.toString().trim() || '',
      drive_url: data.get('drive_url')?.toString().trim() || '',
      link_type: data.get('link_type')?.toString() || 'download',
      is_published: isPublished,
      show_app_opener: data.get('show_app_opener') === 'true',
      app_link: data.get('app_link')?.toString().trim() || '',
      app_title: data.get('app_title')?.toString().trim() || '',
      app_description: data.get('app_description')?.toString().trim() || '',
      app_button_text: data.get('app_button_text')?.toString().trim() || '',
      telegram_url: data.get('telegram_url')?.toString().trim() || 'https://t.me/hscfreepdf',
      telegram_btn_text: data.get('telegram_btn_text')?.toString().trim() || 'টেলিগ্রাম চ্যানেলে জয়েন করুন →',
      seo_title: data.get('seo_title')?.toString().trim() || '',
      meta_description: data.get('meta_description')?.toString().trim() || '',
      focus_keyword: data.get('focus_keyword')?.toString().trim() || '',
      schema_type: data.get('schema_type')?.toString() || 'Article',
    };

    if (editId) {
      const updateRes = await fetch(`${dbUrl}/rest/v1/posts?id=eq.${editId}`, {
        method: 'PATCH',
        headers: {
          'apikey': dbWriteKey,
          'Authorization': `Bearer ${dbWriteKey}`,
          'Content-Type': 'application/json',
          'Prefer': 'return=representation'
        },
        body: JSON.stringify(payload)
      });

      if (updateRes.ok) {
        successMessage = 'পোস্টটি সফলভাবে আপডেট করা হয়েছে।';
        postData = { ...postData, ...payload };
      } else {
        const errJson = await updateRes.json().catch(() => ({}));
        errorMessage = `আপডেট ব্যর্থ হয়েছে: ${errJson.message || 'ডাটাবেজ সমস্যা।'}`;
      }
    } else {
      const createRes = await fetch(`${dbUrl}/rest/v1/posts`, {
        method: 'POST',
        headers: {
          'apikey': dbWriteKey,
          'Authorization': `Bearer ${dbWriteKey}`,
          'Content-Type': 'application/json',
          'Prefer': 'return=representation'
        },
        body: JSON.stringify(payload)
      });

      if (createRes.ok) {
        return Astro.redirect('/admin?success=true');
      } else {
        const errJson = await createRes.json().catch(() => ({}));
        errorMessage = `সংরক্ষণ ব্যর্থ হয়েছে: ${errJson.message || 'সম্ভবত এই স্লাগ (slug) আগে ব্যবহার হয়েছে।'}`;
      }
    }
  } catch (e) {
    errorMessage = 'পোস্টটি সেভ করার সময় একটি সমস্যা হয়েছে।';
  }
}
---

<BaseLayout title="এডমিন এডিটর - প্রস্তুতি BD">
  <AdminNav />

  <main class="container editor-wrap">
    <header class="page-head">
      <div>
        <h1>{editId ? "পোস্ট সম্পাদনা" : "নতুন পোস্ট"}</h1>
        <p>শিরোনাম, ক্যাটাগরি আর ফাইল লিংক দিন। বাকিটা ছোট করা যায়।</p>
      </div>
      <div class="head-actions">
        <a href="/admin" class="btn btn-text">বাতিল</a>
        <button type="submit" form="main-editor-form" class="btn btn-primary">সংরক্ষণ করুন</button>
      </div>
    </header>

    {successMessage && <div class="alert alert-ok">{successMessage}</div>}
    {errorMessage && <div class="alert alert-bad">{errorMessage}</div>}

    <form method="POST" enctype="multipart/form-data" id="main-editor-form" class="stack">
      <section class="panel">
        <div class="field">
          <label for="title">শিরোনাম *</label>
          <input type="text" id="title" name="title" value={postData.title} required placeholder="যেমন: HSC 2026 পদার্থবিজ্ঞান সাজেশন" />
        </div>

        <div class="field">
          <label for="content">বিস্তারিত লিখুন</label>
          <textarea id="content" name="content" rows="10" placeholder="সাজেশন, নোট বা বিবরণ এখানে লিখুন।">{postData.content}</textarea>
        </div>

        <div class="grid-3">
          <div class="field">
            <label for="exam">পরীক্ষা *</label>
            <select id="exam" name="exam" required>
              {['HSC', 'SSC', 'Admission', 'BCS'].map((exam) => (
                <option value={exam} selected={postData.exam === exam}>{exam}</option>
              ))}
            </select>
          </div>
          <div class="field">
            <label for="subject">বিষয় *</label>
            <input type="text" id="subject" name="subject" value={postData.subject} required placeholder="physics" />
          </div>
          <div class="field">
            <label for="chapter">অধ্যায়</label>
            <input type="text" id="chapter" name="chapter" value={postData.chapter || ''} placeholder="motion" />
          </div>
        </div>

        <div class="grid-3">
          <div class="field">
            <label for="resource_type">টাইপ</label>
            <select id="resource_type" name="resource_type">
              {RESOURCE_TYPES.map((type) => (
                <option value={type.value} selected={postData.resource_type === type.value}>{type.label}</option>
              ))}
            </select>
          </div>
          <div class="field">
            <label for="academic_year">বছর</label>
            <input type="text" id="academic_year" name="academic_year" value={postData.academic_year || ''} placeholder="2026" />
          </div>
          <div class="field">
            <label for="status">স্ট্যাটাস</label>
            <select id="status" name="status" required>
              {STATUS_OPTIONS.map((item) => (
                <option value={item.value} selected={postData.status === item.value}>{item.label}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="field">
          <label for="file_url">ফাইল লিংক *</label>
          <input type="url" id="file_url" name="file_url" value={postData.file_url || ''} required placeholder="https://t.me/... বা PDF CDN লিংক" />
        </div>
        <div class="field">
          <label for="drive_url">সেকেন্ডারি লিংক (ঐচ্ছিক)</label>
          <input type="url" id="drive_url" name="drive_url" value={postData.drive_url || ''} placeholder="গুগল ড্রাইভ লিংক" />
        </div>

        <div class="field radio-row">
          <label>লিংক বাটন চালাবে যেভাবে</label>
          <div class="radio-group">
            <label class="radio">
              <input type="radio" name="link_type" value="download" checked={postData.link_type !== 'direct'} />
              <span>টাইমার পেজ (৫ সেকেন্ড অপেক্ষা)</span>
            </label>
            <label class="radio">
              <input type="radio" name="link_type" value="direct" checked={postData.link_type === 'direct'} />
              <span>সরাসরি লিংকে নিয়ে যাবে</span>
            </label>
          </div>
        </div>
      </section>

      <details class="adv">
        <summary>অ্যাডভান্সড সেটিংস</summary>
        <section class="panel">
          <div class="grid-2">
            <div class="field">
              <label for="slug">Slug (URL অংশ)</label>
              <input type="text" id="slug" name="slug" value={postData.slug || ''} placeholder="physics-suggestion-2026" />
            </div>
            <div class="field">
              <label for="schema_type">Schema টাইপ</label>
              <select id="schema_type" name="schema_type">
                <option value="Article" selected={postData.schema_type === 'Article'}>Article</option>
                <option value="FAQ" selected={postData.schema_type === 'FAQ'}>FAQ</option>
              </select>
            </div>
            <div class="field">
              <label for="image_url">কভার ইমেজ URL</label>
              <input type="url" id="image_url" name="image_url" value={postData.image_url || ''} placeholder="https://example.com/cover.jpg" />
            </div>
            <div class="field">
              <label for="image_alt">Image Alt Text</label>
              <input type="text" id="image_alt" name="image_alt" value={postData.image_alt || ''} placeholder="ছবির বিবরণ" />
            </div>
            <div class="field">
              <label for="telegram_url">টেলিগ্রাম চ্যানেল</label>
              <input type="url" id="telegram_url" name="telegram_url" value={postData.telegram_url || 'https://t.me/hscfreepdf'} placeholder="https://t.me/hscfreepdf" />
            </div>
            <div class="field">
              <label for="telegram_btn_text">বাটনের লেখা</label>
              <input type="text" id="telegram_btn_text" name="telegram_btn_text" value={postData.telegram_btn_text || 'টেলিগ্রাম চ্যানেলে জয়েন করুন →'} placeholder="টেলিগ্রাম চ্যানেল" />
            </div>
            <div class="field">
              <label for="seo_title">SEO শিরোনাম</label>
              <input type="text" id="seo_title" name="seo_title" value={postData.seo_title || ''} placeholder="সার্চ রেজাল্টের শিরোনাম" />
            </div>
            <div class="field">
              <label for="focus_keyword">মূল কিওয়ার্ড</label>
              <input type="text" id="focus_keyword" name="focus_keyword" value={postData.focus_keyword || ''} placeholder="HSC Physics Suggestion" />
            </div>
            <div class="field">
              <label for="license">লাইসেন্স</label>
              <select id="license" name="license">
                {LICENSE_OPTIONS.map((item) => (
                  <option value={item.value} selected={postData.license === item.value}>{item.label}</option>
                ))}
              </select>
            </div>
            <div class="field">
              <label for="source">সোর্স / ক্রেডিট</label>
              <input type="text" id="source" name="source" value={postData.source || ''} placeholder="নিজস্ব / কোচিং / URL" />
            </div>
          </div>

          <div class="field">
            <label>বিজ্ঞাপন টেক্সট</label>
            <textarea id="ad_text" name="ad_text" rows="3" placeholder="পোস্টের নিচে দেখানোর বিজ্ঞাপন লেখা">{postData.ad_text}</textarea>
          </div>

          <div class="field">
            <label>ফাইল আপলোড (ঐচ্ছিক)</label>
            <input type="file" id="pdf_file" name="pdf_file" accept="application/pdf,.pdf" />
            <input type="file" id="cover_image" name="cover_image" accept="image/png,image/jpeg,image/webp" />
          </div>

          <label class="toggle">
            <input type="checkbox" name="show_app_opener" value="true" checked={postData.show_app_opener !== false} />
            <span>পোস্টে অ্যাপ প্রমোশন ব্যানার দেখান</span>
          </label>
          <div class="field">
            <label for="app_link">অ্যাপ লিংক</label>
            <input type="url" id="app_link" name="app_link" value={postData.app_link || ''} placeholder={`${APP_CTA_ORIGIN}/practice/...`} />
          </div>
          <div class="grid-3">
            <div class="field">
              <label for="app_title">ব্যানার শিরোনাম</label>
              <input type="text" id="app_title" name="app_title" value={postData.app_title || ''} />
            </div>
            <div class="field">
              <label for="app_description">ব্যানার বিবরণ</label>
              <input type="text" id="app_description" name="app_description" value={postData.app_description || ''} />
            </div>
            <div class="field">
              <label for="app_button_text">বাটন লেখা</label>
              <input type="text" id="app_button_text" name="app_button_text" value={postData.app_button_text || ''} />
            </div>
          </div>
        </section>
      </details>

      <footer class="form-foot">
        <a href="/admin" class="btn btn-text">বাতিল</a>
        <button type="submit" class="btn btn-primary btn-lg">সংরক্ষণ করুন</button>
      </footer>
    </form>
  </main>
</BaseLayout>

<script is:inline define:vars={{ postData }}>
  const titleInput = document.getElementById('title');
  const slugInput = document.getElementById('slug');
  if (titleInput && slugInput && !(postData && postData.slug)) {
    titleInput.addEventListener('blur', () => {
      const value = titleInput.value
        .toLowerCase()
        .trim()
        .replace(/[^\p{L}\p{N}\s-]/gu, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '');
      if (value && !slugInput.value.trim()) slugInput.value = value;
    });
  }
</script>

<style>
  .editor-wrap { max-width: 860px; margin-top: 2rem; padding-bottom: 5rem; }
  .page-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .page-head h1 { font-size: 1.75rem; font-weight: 700; line-height: 1.2; }
  .page-head p { color: var(--text-secondary); margin-top: 0.35rem; }
  .head-actions, .form-foot { display: flex; align-items: center; gap: 1rem; }
  .stack, .form-all { display: flex; flex-direction: column; gap: 1rem; }

  .panel { background: var(--bg-surface); border: 1px solid var(--border-hairline); padding: 1.5rem; margin-bottom: 1.25rem; }
  .field { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1rem; }
  .field label { font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); font-family: var(--font-mono); }
  .field input, .field select, .field textarea {
    background: var(--bg-base); border: 1px solid var(--border-hairline); color: var(--text-primary);
    padding: 0.7rem 0.85rem; font-size: 0.95rem; width: 100%; outline: none; border-radius: 0;
  }
  .field input:focus, .field select:focus, .field textarea:focus { border-color: var(--accent); }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.25rem; }
  .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0 1.25rem; }

  .radio-row { margin-top: 0.25rem; }
  .radio-group { display: flex; gap: 1.5rem; flex-wrap: wrap; padding-top: 0.25rem; }
  .radio { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; color: var(--text-primary); cursor: pointer; }
  .radio input { width: auto; accent-color: var(--accent); }
  .toggle { display: flex; align-items: center; gap: 0.6rem; font-size: 0.9rem; color: var(--text-primary); margin-bottom: 1rem; cursor: pointer; }
  .toggle input { width: auto; accent-color: var(--accent); }

  .adv { background: var(--bg-surface); border: 1px solid var(--border-hairline); margin-bottom: 1.25rem; }
  .adv > summary { list-style: none; cursor: pointer; padding: 1rem 1.25rem; font-weight: 700; font-size: 0.95rem; display: flex; align-items: center; gap: 0.5rem; }
  .adv > summary::-webkit-details-marker { display: none; }
  .adv > summary::before { content: '+'; font-family: var(--font-mono); color: var(--accent); font-weight: 700; }
  .adv[open] > summary::before { content: '−'; }
  .adv[open] > .panel { border: none; border-top: 1px solid var(--border-hairline); margin: 0; }

  .form-foot { border-top: 1px solid var(--border-hairline); padding-top: 1.5rem; display: flex; justify-content: flex-end; }
  .btn { display: inline-flex; align-items: center; gap: 0.4rem; border-radius: 0; border: 1px solid var(--border-hairline); background: none; color: var(--text-primary); text-decoration: none; font-weight: 600; font-size: 0.9rem; padding: 0.65rem 1.25rem; cursor: pointer; }
  .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .btn-primary:hover { background: var(--accent-strong); }
  .btn-text { border-color: transparent; color: var(--text-secondary); }
  .btn-text:hover { color: var(--text-primary); text-decoration: underline; }
  .btn-lg { font-size: 1rem; padding: 0.8rem 1.75rem; }

  .alert { padding: 0.9rem 1.1rem; border: 1px solid var(--border-hairline); margin-bottom: 1.25rem; font-size: 0.95rem; }
  .alert-ok { border-color: var(--accent); color: var(--accent); }
  .alert-bad { border-color: var(--accent-danger); color: var(--accent-danger); }

  @media (max-width: 640px) {
    .grid-3, .grid-2 { grid-template-columns: 1fr; }
    .page-head { flex-direction: column; }
  }
</style>