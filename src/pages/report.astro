---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const title = "রিপোর্ট / Takedown";
const description =
  "অনুপযুক্ত PDF, কপিরাইট অভিযোগ বা ভাঙা লিংক রিপোর্ট করুন। Prostuti BD দ্রুত পর্যালোচনা করে ব্যবস্থা নেবে।";

let submitted = false;
let errorMessage = "";

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    const reportType = data.get("report_type")?.toString().trim() || "";
    const resourceUrl = data.get("resource_url")?.toString().trim() || "";
    const details = data.get("details")?.toString().trim() || "";
    const email = data.get("email")?.toString().trim() || "";

    if (!reportType || !details) {
      errorMessage = "রিপোর্টের ধরন ও বিবরণ আবশ্যক।";
    } else {
      // Store as site_settings-style log via console for now; ops can wire email/webhook later.
      console.info("[content-report]", {
        reportType,
        resourceUrl,
        details,
        email,
        at: new Date().toISOString(),
      });
      submitted = true;
    }
  } catch (e) {
    errorMessage = "রিপোর্ট জমা দিতে সমস্যা হয়েছে। একটু পর আবার চেষ্টা করুন।";
  }
}
---

<BaseLayout title={title} description={description} canonicalPath="/report" pageType="website">
  <Navbar showSearch={false} showBackLink={true} />
  <main class="container legal-page">
    <article class="glass-card legal-card">
      <h1>{title}</h1>
      <p>
        কপিরাইট, ভুল মেটাডেটা, ভাঙা ডাউনলোড লিংক বা নীতি লঙ্ঘনের অভিযোগ এখানে জানান। আমরা
        <a href="/content-policy">কনটেন্ট নীতি</a> অনুযায়ী পর্যালোচনা করব।
      </p>

      {
        submitted ? (
          <div class="alert-success">
            রিপোর্ট গ্রহণ করা হয়েছে। প্রয়োজনে আমরা ইমেইলে যোগাযোগ করব।
          </div>
        ) : (
          <form method="POST" class="report-form">
            {errorMessage && <div class="alert-danger">{errorMessage}</div>}
            <label>
              রিপোর্টের ধরন *
              <select name="report_type" required>
                <option value="">নির্বাচন করুন</option>
                <option value="copyright">কপিরাইট / অধিকার</option>
                <option value="broken_link">ভাঙা ডাউনলোড লিংক</option>
                <option value="wrong_metadata">ভুল তথ্য / মেটাডেটা</option>
                <option value="policy">কনটেন্ট নীতি লঙ্ঘন</option>
                <option value="other">অন্যান্য</option>
              </select>
            </label>
            <label>
              রিসোর্স URL (থাকলে)
              <input type="url" name="resource_url" placeholder="https://prostutibd.app/hsc/..." />
            </label>
            <label>
              আপনার ইমেইল (ঐচ্ছিক)
              <input type="email" name="email" placeholder="you@example.com" />
            </label>
            <label>
              বিবরণ *
              <textarea name="details" rows="5" required placeholder="সমস্যার সংক্ষিপ্ত বিবরণ লিখুন..." />
            </label>
            <button type="submit" class="btn btn-primary">রিপোর্ট জমা দিন</button>
          </form>
        )
      }
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .legal-page { padding: 1.5rem 0 3rem; max-width: 820px; }
  .legal-card { padding: 1.6rem 1.4rem; display: grid; gap: 1.25rem; }
  .legal-card h1 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .legal-card p { color: var(--text-secondary); line-height: 1.75; }
  .legal-card a { color: var(--color-primary); }
  .report-form { display: grid; gap: 1rem; }
  .report-form label { display: grid; gap: 0.4rem; font-weight: 600; font-size: 0.92rem; }
  .report-form input,
  .report-form select,
  .report-form textarea {
    width: 100%;
    padding: 0.75rem;
    border-radius: 10px;
    border: 1px solid var(--border-soft);
    background: var(--surface-muted);
    color: var(--text-primary);
    font: inherit;
  }
  .alert-success {
    padding: 1rem;
    border-radius: 10px;
    background: rgba(31, 157, 115, 0.15);
    border: 1px solid var(--color-success);
    color: var(--text-primary);
  }
  .alert-danger {
    padding: 0.85rem 1rem;
    border-radius: 10px;
    background: rgba(244, 63, 94, 0.12);
    border: 1px solid #f43f5e;
    color: #fda4af;
  }
</style>
