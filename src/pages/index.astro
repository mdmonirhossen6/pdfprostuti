---
// filepath: src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import PostCard from "../components/PostCard.astro";
import Footer from "../components/Footer.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import { getDbCredentials } from "../utils/db";
import { APP_CTA_ORIGIN } from "../utils/cta";

const runtime = (Astro.locals as { runtime?: { env?: Record<string, string> } })
  .runtime;
const { dbUrl, dbReadKey } = getDbCredentials(runtime);
const url = Astro.url;
const searchQuery = (url.searchParams.get("search") || "").trim();
const selectedCategory = (url.searchParams.get("category") || "").trim();
const selectedSubject = (url.searchParams.get("subject") || "").trim();

let posts: any[] = [];
try {
  const res = await fetch(
    `${dbUrl}/rest/v1/posts?is_published=eq.true&order=created_at.desc&limit=1000`,
    {
      headers: { apikey: dbReadKey, Authorization: `Bearer ${dbReadKey}` },
    },
  );
  if (res.ok) {
    posts = await res.json();
  }
} catch (e) {
  console.error("Error fetching posts:", e);
}

const mockPosts = [
  {
    id: "mock-hsc-physics",
    title: "HSC 2026 পদার্থবিজ্ঞান প্রথম পত্র ১০০% কমন সাজেশন ও সমাধান",
    slug: "physics-1st-paper-suggestion",
    exam: "HSC",
    subject: "physics",
    chapter: "motion",
    resource_type: "suggestion",
    academic_year: "2026",
    content:
      "পরীক্ষার জন্য প্রয়োজনীয় সাজেশন, প্রশ্নব্যাংক, এবং গুরুত্বপূর্ণ অধ্যায়ের ডাউনলোড লিংক।",
    created_at: new Date().toISOString(),
  },
  {
    id: "mock-bcs-bangla",
    title:
      "৪৬তম বিসিএস প্রিলিমিনারি বাংলা ভাষা ও সাহিত্য মডেল টেস্ট ও ব্যাখ্যা",
    slug: "bcs-46-bangla-literature",
    exam: "BCS",
    subject: "bangla",
    chapter: "literature",
    resource_type: "model_test",
    academic_year: "2026",
    content:
      "বিসিএস প্রিলিমিনারি বাংলা ভাষা ও সাহিত্য থেকে গুরুত্বপূর্ণ প্রশ্ন ও ব্যাখ্যা।",
    created_at: new Date().toISOString(),
  },
];

let appUrl = APP_CTA_ORIGIN;
try {
  const settingsRes = await fetch(
    `${dbUrl}/rest/v1/site_settings?key=eq.app_url`,
    {
      headers: { apikey: dbReadKey, Authorization: `Bearer ${dbReadKey}` },
    },
  );
  if (settingsRes.ok) {
    const rows = await settingsRes.json();
    if (rows && rows.length > 0 && rows[0].value) {
      appUrl = rows[0].value;
    }
  }
} catch (e) {
  console.error("Could not fetch app_url setting:", e);
}

const allPosts: any[] = posts && posts.length > 0 ? posts : mockPosts;
const normalizedSearch = searchQuery.toLowerCase();
const filteredPosts = allPosts.filter((post: any) => {
  const title = (post.title || "").toLowerCase();
  const subject = (post.subject || "").toLowerCase();
  const exam = (post.exam || "").toLowerCase();
  const chapter = (post.chapter || "").toLowerCase();
  const year = (post.academic_year || "").toLowerCase();
  const resourceType = (post.resource_type || "").toLowerCase();
  const content = (post.content || "").toLowerCase();
  const slug = (post.slug || "").toLowerCase();
  const searchMatches =
    !normalizedSearch ||
    [title, subject, exam, chapter, year, resourceType, content, slug].some(
      (value) => value.includes(normalizedSearch),
    );
  const categoryMatches =
    !selectedCategory || exam === selectedCategory.toLowerCase();
  const subjectMatches =
    !selectedSubject || subject === selectedSubject.toLowerCase();
  return searchMatches && categoryMatches && subjectMatches;
});

const totalPosts = filteredPosts.length;

const categories = ["HSC", "SSC", "BCS", "Admission"];
const subjectOptions = [
  ...new Set(allPosts.map((post: any) => post.subject).filter(Boolean)),
].sort();
const hasSearchOrFilter = Boolean(
  searchQuery || selectedCategory || selectedSubject,
);
const categoryCount = (cat: string) =>
  allPosts.filter(
    (p: any) => (p.exam || "").toLowerCase() === cat.toLowerCase(),
  ).length;

// Real metadata for the footer line — only shown when data exists.
const lastUpdatedRaw = allPosts
  .map((p: any) => p.created_at)
  .filter(Boolean)
  .sort()
  .at(-1);
const lastUpdated = lastUpdatedRaw
  ? new Date(lastUpdatedRaw).toLocaleDateString("en-CA")
  : "";
const totalResourceCount = allPosts.length;
---

<BaseLayout
  title="সেরা অনলাইন পরীক্ষা ও পিডিএফ সাজেশন"
  description="বাংলাদেশের সবচেয়ে জনপ্রিয় PDF সাজেশন, নোট, মডেল টেস্ট ও পরীক্ষার রিসোর্স খুঁজুন। HSC, SSC, BCS এবং Admission-এর জন্য ফ্রি ডাউনলোড করুন।"
  keywords="pdf download, suggestion, notes, model test, hsc, ssc, bcs, admission"
>
  <div class="landing-page">
    <Navbar appUrl={appUrl} searchQuery={searchQuery} />

    <header class="hero">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="hero-code mono">প্রস্তুতি BD · <em>PDF ARCHIVE</em></p>
          <h1>
            পরীক্ষার পিডিএফ, সাজেশন ও নোট দ্রুত খুঁজুন, পড়ুন,
            ডাউনলোড করুন।
          </h1>
          <p class="hero-subtitle">
            এইচএসসি, এসএসসি, বিসিএস এবং ভর্তি পরীক্ষার সাজেশন, নোট, মডেল টেস্ট
            ও অধ্যায়ভিত্তিক রিসোর্স এক জায়গায়। প্রতিটি ফাইল একটি প্রশ্নপত্রের
            মতো—কোড, সাল ও নথি নম্বরসহ সাজানো।
          </p>
          <div class="hero-actions">
            <a
              href={appUrl}
              class="btn btn-primary"
              target="_blank"
              rel="noopener">অ্যাপ খুলুন</a
            >
            <a href="#suggestions" class="btn-text">PDF ব্রাউজ করুন ↓</a>
          </div>
        </div>

        <div class="hero-search">
          <form class="search-form" method="GET" action="/">
            <label class="field">
              <span>শিরোনাম / বিষয়</span>
              <input
                type="search"
                name="search"
                value={searchQuery}
                placeholder="পিডিএফ শিরোনাম বা বিষয় লিখুন"
              />
            </label>
            <div class="search-row">
              <label class="field">
                <span>ক্যাটাগরি</span>
                <select name="category" aria-label="Filter by category">
                  <option value="">সব ক্যাটাগরি</option>
                  {
                    categories.map((cat) => (
                      <option
                        value={cat.toLowerCase()}
                        selected={selectedCategory === cat.toLowerCase()}
                      >
                        {cat}
                      </option>
                    ))
                  }
                </select>
              </label>
              <label class="field">
                <span>বিষয়</span>
                <select name="subject" aria-label="Filter by subject">
                  <option value="">সব বিষয়</option>
                  {
                    subjectOptions.map((subject: string) => (
                      <option
                        value={subject}
                        selected={selectedSubject === subject}
                      >
                        {subject}
                      </option>
                    ))
                  }
                </select>
              </label>
            </div>
            <button type="submit" class="btn btn-primary btn-block">
              ফিল্টার করুন
            </button>
          </form>
        </div>
      </div>
    </header>

    <section id="categories" class="exams-section">
      <div class="section-shell">
        <div class="section-head">
          <h3>পরীক্ষা অনুযায়ী</h3>
          <span class="section-no">SEC.01 / EXAMS</span>
        </div>

        <div class="exam-index">
          {
            categories.map((cat, index) => {
              const count = categoryCount(cat);
              return (
                <a href={`/${cat.toLowerCase()}`} class="stat-box">
                  <span class="stat-label">
                    {String(index + 1).padStart(2, "0")} · {cat.toUpperCase()}
                  </span>
                  <span class="stat-name">
                    {cat === "BCS"
                      ? "বিসিএস প্রিলিমিনারি"
                      : cat === "Admission"
                        ? "বিশ্ববিদ্যালয় ভর্তি"
                        : `${cat} পরীক্ষা`}
                  </span>
                  <span class="stat-value">
                    {count > 0 ? <em>{count}</em> : "০"} ফাইল
                  </span>
                </a>
              );
            })
          }
        </div>
      </div>
    </section>

    <section id="suggestions" class="results-section">
      <div class="section-shell">
        <div class="section-head">
          <h3>
            {
              hasSearchOrFilter
                ? "ফিল্টার করা ফলাফল"
                : "সাম্প্রতিক সাজেশন ও ফাইলসমূহ"
            }
          </h3>
          <span class="section-no">
            {hasSearchOrFilter ? `${totalPosts} hit(s)` : `RES-02 / ${totalPosts}`}
          </span>
        </div>

        {
          filteredPosts.length > 0 ? (
            <div class="ledger-grid posts-grid">
              {filteredPosts.map((post) => (
                <PostCard post={post} variant="grid" />
              ))}
            </div>
          ) : (
            <div class="empty-stamp">
              <span class="stamp-word">খালি</span>
              <p>এই অনুসন্ধানে কোনো PDF পাওয়া যায়নি।</p>
              <span class="mono">STATUS: NO_MATCH — অন্য কীওয়ার্ড, ক্যাটাগরি বা বিষয় ব্যবহার করুন</span>
            </div>
          )
        }
      </div>
    </section>

    <Footer appUrl={appUrl} resourceCount={totalResourceCount} lastUpdated={lastUpdated} />
    <ScrollToTop />
  </div>
</BaseLayout>

<style>
  .landing-page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  .hero {
    padding: 2.5rem 1.25rem 1.25rem;
  }
  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 2rem;
    align-items: start;
  }
  .hero-copy h1 {
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    line-height: 1.45;
    margin-bottom: 0.9rem;
  }
  .hero-subtitle {
    color: var(--text-secondary);
    max-width: 540px;
    line-height: 1.8;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    flex-wrap: wrap;
    margin-top: 1.4rem;
  }

  /* Editorial search block — ruled on top, sits on paper */
  .hero-search {
    border-top: 3px solid var(--border-strong);
    border-right: 1px solid var(--border-hairline);
    border-bottom: 1px solid var(--border-hairline);
    border-left: 1px solid var(--border-hairline);
    padding: 1.15rem;
    background: var(--bg-surface);
  }
  .search-form {
    display: grid;
    gap: 0.85rem;
  }
  .search-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .field span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .field input,
  .field select {
    padding: 0.65rem 0.8rem;
    border-radius: 0;
    border: 1px solid var(--border-hairline);
    background: var(--bg-base);
    color: var(--text-primary);
  }
  .field input:focus,
  .field select:focus {
    border-color: var(--accent);
    outline: none;
  }
  .search-form .btn-primary {
    justify-self: stretch;
  }

  .exams-section,
  .results-section {
    padding: 1.5rem 1.25rem 1.25rem;
  }
  .section-shell {
    max-width: 1200px;
    margin: 0 auto;
  }
  .exam-index {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0;
    border: 1px solid var(--border-hairline);
    background: var(--border-hairline);
  }
  .exam-index .stat-box {
    border: none;
    background: var(--bg-surface);
  }
  .exam-index .stat-box:hover {
    background: var(--bg-surface-raised);
    border-color: var(--bg-surface);
  }

  .posts-grid {
    margin-bottom: 1.5rem;
  }

  @media (max-width: 960px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
  @media (max-width: 600px) {
    .hero { padding: 1.5rem 1rem 0.8rem; }
    .exams-section, .results-section { padding-left: 1rem; padding-right: 1rem; }
    .search-row { grid-template-columns: 1fr; }
    .ledger-grid { grid-template-columns: 1fr; }
  }
</style>