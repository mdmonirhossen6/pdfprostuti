---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import ResourceList from "../../../components/ResourceList.astro";
import TrackingScript from "../../../components/TrackingScript.astro";
import { getDbCredentials } from "../../../utils/db";
import {
  resolveExam,
  fetchPublishedPosts,
  groupByChapter,
  examPath,
  subjectPath,
  chapterPath,
  displayLabel,
  SITE_ORIGIN,
} from "../../../utils/hubs";
import { buildAppCtaUrl } from "../../../utils/cta";

const { exam: examParam, subject: subjectParam } = Astro.params;
const examMeta = resolveExam(examParam);
const subject = (subjectParam || "").toLowerCase();

if (!examMeta || !subject) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const runtime = (Astro.locals as { runtime?: { env?: Record<string, string> } }).runtime;
const { dbUrl, dbReadKey } = getDbCredentials(runtime);

let posts = [];
try {
  posts = await fetchPublishedPosts(dbUrl, dbReadKey, {
    exam: examMeta.key,
    subject,
  });
} catch (e) {
  console.error("Subject hub fetch failed:", e);
}

const chapters = groupByChapter(posts);
const subjectLabel = displayLabel(subject);
const canonicalPath = subjectPath(examMeta.key, subject);
const pageTitle = `${examMeta.key} ${subjectLabel} PDF | Prostuti BD`;
const pageDescription = `${examMeta.key} ${subjectLabel} বিষয়ের নোট, সাজেশন, প্রশ্নপত্র ও মডেল টেস্ট PDF ডাউনলোড করুন। অধ্যায়ভিত্তিক সংগ্রহ।`;
const appCta = buildAppCtaUrl({
  exam: examMeta.key,
  subject,
  contentPlacement: "subject-hub",
  medium: "hub",
});

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: pageTitle,
  description: pageDescription,
  url: `${SITE_ORIGIN}${canonicalPath}`,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: posts.length,
    itemListElement: posts.slice(0, 40).map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: post.title,
      url: `${SITE_ORIGIN}${subjectPath(post.exam, post.subject)}/${post.slug}`,
    })),
  },
};

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400",
);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  exam={examMeta.key}
  subject={subject}
  keywords={`${examMeta.key}, ${subjectLabel}, pdf, notes, suggestion`}
  seoTitle={pageTitle}
  metaDescription={pageDescription}
  canonicalPath={canonicalPath}
  pageType="collection"
  extraSchemas={[collectionSchema]}
>
  <TrackingScript />
  <Navbar showSearch={true} />
  <main class="container hub-page">
    <nav class="hub-breadcrumb mono" aria-label="Breadcrumb">
      <a href="/">প্রচ্ছদ</a>
      <span>/</span>
      <a href={examPath(examMeta.key)}>{examMeta.key}</a>
      <span>/</span>
      <span aria-current="page">{subjectLabel}</span>
    </nav>

    <header class="hub-hero">
      <p class="hero-code mono">
        {examMeta.labelBn} · {subjectLabel} ·{" "}
        <em>{`${examMeta.key.toUpperCase()}/${subject.slice(0, 4).toUpperCase()}`}</em>
      </p>
      <h1>{examMeta.key} {subjectLabel} PDF</h1>
      <p>{pageDescription}</p>
      <div class="hub-hero-actions">
        <a
          class="btn btn-primary"
          href={appCta}
          target="_blank"
          rel="noopener"
          data-track="cta"
          data-exam={examMeta.key}
          data-subject={subject}
          data-placement="subject-hub"
        >অ্যাপে প্র্যাকটিস করুন</a>
        <a class="btn-text" href={examPath(examMeta.key)}>সব বিষয় দেখুন ←</a>
      </div>
    </header>

    {
      chapters.length > 0 && (
        <section class="hub-section">
          <div class="section-head">
            <h2>অধ্যায় / টপিক</h2>
            <span class="section-no">SEC.01 / CHAPTERS</span>
          </div>
          <div class="ledger-list">
            {chapters.map((item, index) => (
              <a
                class="ledger-row"
                href={chapterPath(examMeta.key, subject, item.chapter)}
              >
                <span class="omr filled" aria-hidden="true"></span>
                <strong>{displayLabel(item.chapter)}</strong>
                <span class="ledger-sub mono">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="count">{item.count} PDF</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section class="hub-section">
      <div class="section-head">
        <h2>সব ফাইল ({posts.length})</h2>
        <span class="section-no">SEC.02 / ALL</span>
      </div>
      <ResourceList
        posts={posts}
        emptyMessage={`${subjectLabel} বিষয়ে এখনো পাবলিশড PDF নেই।`}
      />
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .hub-page { padding-bottom: 3rem; }
  .hub-breadcrumb {
    display: flex; gap: 0.5rem; flex-wrap: wrap;
    color: var(--text-muted); font-size: 0.82rem; letter-spacing: 0.04em;
    margin: 1.25rem 0 1rem;
    text-transform: uppercase;
  }
  .hub-breadcrumb a { color: var(--text-secondary); text-decoration: none; }
  .hub-breadcrumb a:hover { color: var(--text-primary); }
  .hub-hero {
    padding: 1.6rem 0;
    margin-bottom: 2rem;
    border-top: 3px solid var(--border-strong);
    border-bottom: 1px solid var(--border-hairline);
  }
  .hub-hero h1 { font-size: clamp(1.55rem, 3vw, 2.1rem); margin-bottom: 0.6rem; }
  .hub-hero p { color: var(--text-secondary); max-width: 46rem; }
  .hub-hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.1rem; margin-top: 1rem; }
  .hub-section { margin-bottom: 2.25rem; }
</style>
