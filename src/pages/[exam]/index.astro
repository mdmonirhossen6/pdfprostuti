---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ResourceList from "../../components/ResourceList.astro";
import TrackingScript from "../../components/TrackingScript.astro";
import { getDbCredentials } from "../../utils/db";
import {
  resolveExam,
  fetchPublishedPosts,
  groupBySubject,
  subjectPath,
  SITE_ORIGIN,
  displayLabel,
} from "../../utils/hubs";

const { exam: examParam } = Astro.params;
const examMeta = resolveExam(examParam);

if (!examMeta) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const runtime = (Astro.locals as { runtime?: { env?: Record<string, string> } }).runtime;
const { dbUrl, dbReadKey } = getDbCredentials(runtime);

let posts = [];
try {
  posts = await fetchPublishedPosts(dbUrl, dbReadKey, { exam: examMeta.key });
} catch (e) {
  console.error("Category hub fetch failed:", e);
}

const subjects = groupBySubject(posts);
const canonicalPath = `/${examMeta.key.toLowerCase()}`;
const pageTitle = `${examMeta.headline} | Prostuti BD`;
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: examMeta.headline,
  description: examMeta.description,
  url: `${SITE_ORIGIN}${canonicalPath}`,
  isPartOf: { "@type": "WebSite", name: "Prostuti BD", url: SITE_ORIGIN },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: posts.length,
    itemListElement: subjects.slice(0, 50).map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: displayLabel(item.subject),
      url: `${SITE_ORIGIN}${subjectPath(examMeta.key, item.subject)}`,
    })),
  },
};

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400",
);
---

<BaseLayout
  title={pageTitle}
  description={examMeta.description}
  exam={examMeta.key}
  keywords={`${examMeta.key}, pdf, suggestion, notes, download, ${examMeta.labelBn}`}
  seoTitle={pageTitle}
  metaDescription={examMeta.description}
  canonicalPath={canonicalPath}
  pageType="collection"
  extraSchemas={[collectionSchema]}
>
  <TrackingScript />
  <Navbar showSearch={true} />
  <main class="container hub-page">
    <nav class="hub-breadcrumb mono" aria-label="Breadcrumb">
      <a href="/">প্রচ্ছদ</a>
      <span>/</span>
      <span aria-current="page">{examMeta.key}</span>
    </nav>

    <header class="hub-hero">
      <p class="hero-code mono">
        {examMeta.labelBn} · <em>{examMeta.key.toUpperCase()}</em>
      </p>
      <h1>{examMeta.headline}</h1>
      <p>{examMeta.description}</p>
      <p class="hub-count mono">
        {posts.length} FILES / {subjects.length} SUBJECTS
      </p>
    </header>

    <section class="hub-section">
      <div class="section-head">
        <h2>বিষয় অনুযায়ী</h2>
        <span class="section-no">SEC.01 / SUBJECTS</span>
      </div>
      {
        subjects.length === 0 ? (
          <div class="empty-stamp">
            <span class="stamp-word">খালি</span>
            <p>এই ক্যাটাগরিতে এখনো পাবলিশড PDF নেই।</p>
            <span class="mono">STATUS: NO_DOCUMENTS</span>
          </div>
        ) : (
          <div class="ledger-list">
            {subjects.map((item, index) => (
              <a
                class="ledger-row"
                href={subjectPath(examMeta.key, item.subject)}
              >
                <span class="omr filled" aria-hidden="true"></span>
                <strong>{displayLabel(item.subject)}</strong>
                <span class="ledger-sub mono">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="count">{item.count} PDF</span>
              </a>
            ))}
          </div>
        )
      }
    </section>

    <section class="hub-section">
      <div class="section-head">
        <h2>সাম্প্রতিক ফাইল</h2>
        <span class="section-no">SEC.02 / RECENT</span>
      </div>
      <ResourceList posts={posts.slice(0, 12)} />
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .hub-page { padding-bottom: 3rem; }
  .hub-breadcrumb {
    display: flex; gap: 0.5rem; flex-wrap: wrap;
    color: var(--text-muted); font-size: 0.82rem; letter-spacing: 0.04em;
    margin: 1.25rem 0 1rem;
    text-transform: uppercase;
  }
  .hub-breadcrumb a { color: var(--text-secondary); text-decoration: none; }
  .hub-breadcrumb a:hover { color: var(--text-primary); }
  .hub-hero {
    padding: 1.6rem 0;
    margin-bottom: 2rem;
    border-top: 3px solid var(--border-strong);
    border-bottom: 1px solid var(--border-hairline);
  }
  .hub-hero h1 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 0.6rem; }
  .hub-hero p { color: var(--text-secondary); max-width: 46rem; }
  .hub-count { margin-top: 0.9rem; color: var(--text-muted); font-size: 0.78rem; letter-spacing: 0.08em; }
  .hub-section { margin-bottom: 2.25rem; }
</style>
