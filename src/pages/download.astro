---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import TrackingScript from "../components/TrackingScript.astro";
import { getDbCredentials } from "../utils/db";
import { buildAppCtaUrl } from "../utils/cta";

const runtime = (Astro.locals as { runtime?: { env?: Record<string, string> } })
  .runtime;
const { dbUrl, dbReadKey } = getDbCredentials(runtime);
const { searchParams } = Astro.url;
const fileId = searchParams.get("id");

let fileInfo = null;

try {
  const res = await fetch(`${dbUrl}/rest/v1/posts?id=eq.${fileId}`, {
    headers: { apikey: dbReadKey, Authorization: `Bearer ${dbReadKey}` },
  });
  if (res.ok) {
    const data = await res.json();
    fileInfo = data[0];
  }
} catch (e) {
  console.error("Error querying download file details:", e);
}

if (!fileInfo && fileId && fileId.startsWith("mock-")) {
  fileInfo = {
    id: fileId,
    title: "পদার্থবিজ্ঞান ১ম পত্র ১০০% কমন সাজেশন্স",
    exam: "HSC",
    subject: "physics",
    chapter: "",
    slug: "physics-1st-paper-suggestion",
    file_url: "https://t.me/hscfreepdf",
    drive_url: "https://drive.google.com/open?id=mock",
    show_app_opener: true,
    app_link: null,
  };
}

if (!fileInfo) {
  return Astro.redirect("/");
}

const getLinkDetails = (url: string | null) => {
  if (!url) return null;
  const isTelegram = url.includes("t.me") || url.includes("telegram.org");
  const isDrive =
    url.includes("drive.google.com") || url.includes("docs.google.com");
  const isDirectPdf = url.endsWith(".pdf");
  return {
    url,
    isTelegram,
    isDrive,
    isDirectPdf,
    label: isTelegram
      ? 'টেলিগ্রাম লিংকে যান →'
      : isDrive
        ? 'গুগল ড্রাইভ লিংকে যান →'
        : isDirectPdf
          ? 'সরাসরি PDF লিংকে যান →'
          : 'এক্সটার্নাল লিংকে যান →',
  };
};

const primaryLink = getLinkDetails(fileInfo.file_url);
const secondaryLink = getLinkDetails(fileInfo.drive_url);
const showAppOpener = fileInfo.show_app_opener !== false;
const appLinkUrl = buildAppCtaUrl({
  exam: fileInfo.exam,
  subject: fileInfo.subject,
  chapter: fileInfo.chapter,
  slug: fileInfo.slug,
  resourceId: fileInfo.id,
  customAppLink: fileInfo.app_link,
  contentPlacement: "download",
  medium: "download",
});

const trackBase = {
  resourceId: fileInfo.id,
  exam: fileInfo.exam || "",
  subject: fileInfo.subject || "",
  chapter: fileInfo.chapter || "",
  slug: fileInfo.slug || "",
};
---

<BaseLayout
  title={`${fileInfo?.title || "ফাইল"} ডাউনলোড - Prostuti BD`}
  description="বিরতিহীন ও দ্রুত ডাউনলোড লিংক। PDF, সাজেশন ও নোট সংগ্রহ করুন."
>
  <TrackingScript />
  <Navbar showSearch={false} showBackLink={true} />
  <main class="download-container">
    <div class="glass-card download-card">
      <div class="paper-strip download-strip">
        <span class="strip-code">FILE: {fileId || "—"}</span>
        <span class="muted">PDF</span>
      </div>
      <header class="header">
        <h2 class="title">{fileInfo?.title || "আপনার ফাইলটি প্রস্তুত হচ্ছে..."}</h2>
        <p class="timer-desc mono">
          DOWNLOAD READY IN <span id="countdown">5</span> SEC
        </p>
      </header>

      <div class="countdown-box" aria-hidden="true">
        <span class="timer-text" id="countdown-text">5</span>
        <div class="countdown-bar">
          <div class="countdown-bar-fill" id="timer-progress"></div>
        </div>
      </div>

      {
        showAppOpener && (
          <div class="app-advertisement">
            <h4>প্রস্তুতি অ্যাপেও আপনি পাচ্ছেন</h4>
            <ul class="features-list">
              <li>
                <span class="feature-no mono">01</span>
                <span>অধ্যায়ভিত্তিক মক টেস্ট</span>
              </li>
              <li>
                <span class="feature-no mono">02</span>
                <span>ভুল উত্তর ব্যাখ্যা ও বিশ্লেষণ</span>
              </li>
              <li>
                <span class="feature-no mono">03</span>
                <span>প্রস্তুতির অগ্রগতি ট্র্যাকিং</span>
              </li>
            </ul>
            <a
              href={appLinkUrl}
              class="btn btn-app-link"
              target="_blank"
              rel="noopener"
              data-track="cta"
              data-resource-id={trackBase.resourceId}
              data-exam={trackBase.exam}
              data-subject={trackBase.subject}
              data-chapter={trackBase.chapter}
              data-slug={trackBase.slug}
              data-placement="download"
            >
              অ্যাপ খুলুন →
            </a>
          </div>
        )
      }

      <div id="download-actions" class="hidden">
        {
          primaryLink && (
            <a
              href={primaryLink.url}
              class="btn btn-main"
              id="primary-download-link"
              data-track="download"
              data-link-kind="primary"
              data-resource-id={trackBase.resourceId}
              data-exam={trackBase.exam}
              data-subject={trackBase.subject}
              data-chapter={trackBase.chapter}
              data-slug={trackBase.slug}
            >
              {primaryLink.label}
            </a>
          )
        }
        {
          secondaryLink && (
            <a
              href={secondaryLink.url}
              class="btn btn-sub"
              id="secondary-download-link"
              target="_blank"
              rel="noopener"
              data-track="download"
              data-link-kind="secondary"
              data-resource-id={trackBase.resourceId}
              data-exam={trackBase.exam}
              data-subject={trackBase.subject}
              data-chapter={trackBase.chapter}
              data-slug={trackBase.slug}
            >
              {secondaryLink.label}
            </a>
          )
        }
      </div>
    </div>
  </main>
</BaseLayout>

<script define:vars={{ trackBase }}>
  let seconds = 5;
  const countdownEl = document.getElementById("countdown");
  const countdownTextEl = document.getElementById("countdown-text");
  const actionDiv = document.getElementById("download-actions");
  const progressBar = document.getElementById("timer-progress");
  let autoTracked = false;

  async function trackDownload(linkKind, destinationUrl) {
    if (typeof window.__prostutiTrack !== "function") return;
    await window.__prostutiTrack("download", {
      resource_id: trackBase.resourceId,
      exam: trackBase.exam,
      subject: trackBase.subject,
      chapter: trackBase.chapter,
      slug: trackBase.slug,
      link_kind: linkKind,
      destination_url: destinationUrl,
    });
  }

  const timer = setInterval(async () => {
    seconds -= 1;
    if (countdownEl) countdownEl.innerText = seconds.toString();
    if (countdownTextEl) countdownTextEl.innerText = seconds.toString();
    if (progressBar) {
      progressBar.style.width = `${((5 - seconds) / 5) * 100}%`;
    }
    if (seconds <= 0) {
      clearInterval(timer);
      if (actionDiv) {
        actionDiv.classList.remove("hidden");
        actionDiv.classList.add("fade-in");
      }
      const primary = document.getElementById("primary-download-link");
      if (primary?.href && !autoTracked) {
        autoTracked = true;
        await trackDownload("auto", primary.href);
        window.location.href = primary.href;
      }
    }
  }, 1000);
</script>

<style>
  .download-container {
    min-height: calc(100vh - 4rem);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.25rem;
  }
  .download-card {
    max-width: 560px;
    width: 100%;
    text-align: center;
    padding: 0;
    overflow: hidden;
  }
  .download-strip { justify-content: space-between; }
  .header {
    margin-bottom: 1.4rem;
    padding: 1.25rem 1.5rem 0;
    text-align: left;
  }
  .title {
    font-size: 1.45rem;
    margin-bottom: 0.4rem;
    color: var(--text-primary);
    line-height: 1.4;
  }
  .timer-desc {
    color: var(--text-secondary);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
  }
  #countdown {
    color: var(--accent);
    font-weight: 700;
  }
  .countdown-box {
    position: relative;
    width: 90px;
    height: 90px;
    margin: 0 auto 1.4rem;
    border: 2px solid var(--border-strong);
    background: var(--bg-base);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    overflow: hidden;
  }
  .timer-text {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1;
  }
  .countdown-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 6px;
    background: var(--bg-surface-raised);
  }
  .countdown-bar-fill {
    width: 0;
    height: 100%;
    background: var(--accent);
    transition: width 1s linear;
  }
  .app-advertisement {
    border: 1px solid var(--border-soft);
    border-radius: 0;
    padding: 1rem 1.25rem;
    text-align: left;
    margin: 0 1.25rem 1rem;
    background: var(--surface-muted);
    border-top: 3px solid var(--border-strong);
  }
  .app-advertisement h4 {
    margin-bottom: 0.65rem;
    color: var(--text-primary);
    font-size: 1rem;
  }
  .features-list {
    list-style: none;
    display: grid;
    gap: 0.45rem;
    margin-bottom: 0.85rem;
    color: var(--text-secondary);
  }
  .features-list li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .feature-no {
    color: var(--accent);
    font-size: 0.78rem;
    flex-shrink: 0;
  }
  .hidden {
    display: none !important;
  }
  .fade-in {
    animation: fadeIn 0.35s ease-out;
  }
  #download-actions {
    padding: 0 1.25rem 1.5rem;
  }
  .btn-main {
    display: flex;
    width: 100%;
    margin-bottom: 0.7rem;
    background: var(--accent);
    border: 1px solid var(--accent);
    color: #F7F3EA;
  }
  .btn-main:hover {
    background: var(--accent-strong);
    border-color: var(--accent-strong);
    color: #F7F3EA;
  }
  .btn-sub {
    display: flex;
    width: 100%;
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border-soft);
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (max-width: 480px) {
    .download-card {
      padding: 1.4rem;
    }
    .title {
      font-size: 1.3rem;
    }
  }
</style>
