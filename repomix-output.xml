<file path="src/pages/[exam]/[subject]/[slug].astro">
---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDbCredentials } from '../../../utils/db';

const { exam, subject, slug } = Astro.params;

const runtime = Astro.locals.runtime;
const { dbUrl, dbReadKey } = getDbCredentials(runtime);

let post = null;

try {
  const res = await fetch(`${dbUrl}/rest/v1/posts?slug=eq.${slug}&exam=eq.${exam ? exam.toUpperCase() : ''}&subject=eq.${subject}`, {
    headers: { 'apikey': dbReadKey, 'Authorization': `Bearer ${dbReadKey}` }
  });
  if (res.ok) {
    const data = await res.json();
    if (data && data.length > 0) {
      post = data[0];
    }
  }
} catch (e) {
  console.error("Error querying post details:", e);
}

// Fallback logic for mock preview testing
if (!post) {
  const isMock = slug === 'physics-1st-paper-suggestion' || slug === 'bcs-46-bangla-literature';
  if (isMock && exam && subject) {
    post = {
      id: `mock-${slug}`,
      title: slug === 'physics-1st-paper-suggestion' 
        ? "HSC 2026 পদার্থবিজ্ঞান প্রথম পত্র ১০০% কমন সাজেশন ও সমাধান" 
        : "৪৬তম বিসিএস প্রিলিমিনারি বাংলা ভাষা ও সাহিত্য মডেল টেস্ট ও ব্যাখ্যা",
      slug: slug,
      exam: exam.toUpperCase(),
      subject: subject,
      content: `পরীক্ষার জন্য প্রয়োজনীয় সাজেশনের বিস্তারিত তালিকা এবং শর্ট সিলেবাস নিচে দেওয়া হলো। সম্পূর্ণ সমাধান সহ ফাইলটি পেতে নিচের বাটনে ক্লিক করুন।`,
