<file path="src/pages/admin/index.astro">
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { verifyAuth, getAdminCredentials } from '../../utils/auth';

const runtime = Astro.locals.runtime;
const isAuthed = await verifyAuth(Astro.cookies, runtime);

if (!isAuthed) {
  return Astro.redirect('/admin/login');
}

const { dbUrl, dbWriteKey, dbReadKey } = getAdminCredentials(runtime);
let errorMessage = '';
let successMessage = '';

const url = new URL(Astro.request.url);
if (url.searchParams.get('success') === 'true') {
  successMessage = 'পোস্টটি সফলভাবে তৈরি করা হয়েছে।';
}

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const action = data.get('action')?.toString();

  if (action === 'logout') {
    Astro.cookies.delete('admin_token', { path: '/' });
    return Astro.redirect('/admin/login');
  }

  if (action === 'delete') {
    const postId = data.get('postId')?.toString();
    try {
      const deleteRes = await fetch(`${dbUrl}/rest/v1/posts?id=eq.${postId}`, {
        method: 'DELETE',
        headers: {
          'apikey': dbWriteKey,
          'Authorization': `Bearer ${dbWriteKey}`
        }
      });
      if (deleteRes.ok) {
        successMessage = 'পোস্টটি সফলভাবে মুছে ফেলা হয়েছে।';
      } else {
        errorMessage = 'পোস্টটি মুছতে ব্যর্থ হয়েছে। ডাটাবেজ পারমিশন ও RLS চেক করুন।';
      }
    } catch (e) {
      errorMessage = 'পোস্টটি মোছার সময় একটি ইরর হয়েছে।';
    }
  }
}

let posts = [];
try {
  const res = await fetch(`${dbUrl}/rest/v1/posts?order=created_at.desc`, {
    headers: { 'apikey': dbReadKey, 'Authorization': `Bearer ${dbReadKey}` }
  });
  if (res.ok) {
    posts = await res.json();
  }
} catch (e) {
  errorMessage = 'ডাটাবেজ থেকে ডাটা লোড করতে সমস্যা হচ্ছে।';
}
---

<BaseLayout title="এডমিন ড্যাশবোর্ড - প্রস্তুতি BD">
