          <ul class="features-list">
            <li>
              <span class="check-icon">✓</span>
              <span class="feature-text">অধ্যায় ভিত্তিক আনলিমিটেড মক টেস্ট</span>
            </li>
            <li>
              <span class="check-icon">✓</span>
              <span class="feature-text">ভুল উত্তরের ব্যাখ্যা এবং বিশ্লেষণ</span>
            </li>
            <li>
              <span class="check-icon">✓</span>
              <span class="feature-text">পূর্ণাঙ্গ সমাধান ও ট্র্যাকিং ড্যাশবোর্ড</span>
            </li>
          </ul>
          <a href={appLinkUrl} class="btn btn-app-link pulse-animation" target="_blank">
            🚀 প্রস্তুতি অ্যাপ ওপেন করুন
          </a>
        </div>
      )}

      <!-- Dynamic, versatile download buttons -->
      <div id="download-actions" class="hidden">
        {primaryLink && (
          <a 
            href={primaryLink.url} 
            class={`btn btn-main ${primaryLink.isTelegram ? 'tg-theme' : primaryLink.isDirectPdf ? 'direct-theme' : 'generic-theme'}`} 
            id="primary-download-link"
          >
            {primaryLink.label}
          </a>
        )}
        {secondaryLink && (
          <a 
            href={secondaryLink.url} 
            class="btn btn-sub" 
            id="secondary-download-link" 
            target="_blank"
          >
            {secondaryLink.label}
          </a>
        )}
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  let seconds = 5;
  const countdownEl = document.getElementById('countdown');
  const countdownTextEl = document.getElementById('countdown-text');
  const actionDiv = document.getElementById('download-actions');
  const progressCircle = document.getElementById('timer-progress') as unknown as SVGElement;

  const circumference = 282.74;
  
  if (progressCircle) {
    progressCircle.style.strokeDasharray = circumference.toString();
    progressCircle.style.strokeDashoffset = '0';
  }

  const timer = setInterval(() => {
    seconds--;
    if (countdownEl) countdownEl.innerText = seconds.toString();
    if (countdownTextEl) countdownTextEl.innerText = seconds.toString();
    
    if (progressCircle) {
      const offset = circumference - (seconds / 5) * circumference;
      progressCircle.style.strokeDashoffset = offset.toString();
    }
    
    if (seconds <= 0) {
      clearInterval(timer);
      if (actionDiv) {
        actionDiv.classList.remove('hidden');
        actionDiv.classList.add('fade-in');
      }
      
      // Auto redirect to primary link upon timer completion
      const primaryUrl = (document.getElementById('primary-download-link') as HTMLAnchorElement | null)?.href;
      if (primaryUrl) {
        window.location.href = primaryUrl;
      }
    }
  }, 1000);
</script>

