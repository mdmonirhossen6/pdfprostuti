<script is:inline define:vars={{ databasePresets }}>
  // Initialize dynamic database-connected presets
  let currentPresets = databasePresets || [];
  let editingPresetId = null;

  const titleInput = document.getElementById('title');
  const slugInput = document.getElementById('slug');

  function slugify(value) {
    return value
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .replace(/^-|-$/g, '');
  }

  // Automatically formulate clean URL slugs
  if (titleInput && slugInput) {
    const syncSlug = () => {
      const titleValue = titleInput.value.trim();
      if (!slugInput.value || slugInput.value === slugify(titleInput.value)) {
        slugInput.value = slugify(titleValue);
      }
    };

    titleInput.addEventListener('input', syncSlug);
    titleInput.addEventListener('blur', syncSlug);
  }

  // Show/hide app_banner extra fields in modal
  function toggleBannerFields(show) {
    document.querySelectorAll('.banner-preset-field').forEach(el => {
      el.style.display = show ? 'block' : 'none';
    });
    const bodyField = document.getElementById('preset-body').parentElement;
    bodyField.style.display = show ? 'none' : 'block';
  }

  // Manage rendering, editing, and deletion of dynamic presets
  function renderPresets() {
    const containers = {
      content: document.getElementById('content-presets-container'),
      ad_text: document.getElementById('ad_text-presets-container'),
      app_banner: document.getElementById('app_banner-presets-container')
    };

    Object.values(containers).forEach(c => { if (c) c.innerHTML = ''; });

    currentPresets.forEach(preset => {
      const parent = containers[preset.field_type];
      if (parent) {
        const chip = document.createElement('div');
        chip.className = 'preset-chip-item';
        
        const labelBtn = document.createElement('button');
        labelBtn.type = 'button';
        labelBtn.className = 'preset-label-btn';
        labelBtn.innerText = `🎯 ${preset.label}`;
        labelBtn.addEventListener('click', () => {
          if (preset.field_type === 'app_banner') {
            try {
              const data = JSON.parse(preset.body);
              document.getElementById('app_title').value = data.title || '';
              document.getElementById('app_description').value = data.description || '';
              document.getElementById('app_button_text').value = data.button_text || '';
            } catch (e) {
              alert('ব্যানার প্রিসেট ডাটা পড়তে সমস্যা হয়েছে।');
            }
          } else {
            const field = document.getElementById(preset.field_type);
            if (field) field.value = preset.body;
          }
        });

        const editBtn = document.createElement('button');
        editBtn.type = 'button';
        editBtn.className = 'preset-edit-btn';
        editBtn.innerHTML = '✏️';
        editBtn.title = 'প্রিসেট সম্পাদনা';
        editBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          editingPresetId = preset.id;
          targetFieldType = preset.field_type;
          document.getElementById('preset-label').value = preset.label;
          
          if (preset.field_type === 'app_banner') {
            toggleBannerFields(true);
            try {
              const data = JSON.parse(preset.body);
              document.getElementById('preset-app-title').value = data.title || '';
              document.getElementById('preset-app-desc').value = data.description || '';
              document.getElementById('preset-app-btn').value = data.button_text || '';
            } catch (e) {}
            document.getElementById('preset-body').value = '';
          } else {
            toggleBannerFields(false);
            document.getElementById('preset-body').value = preset.body;
          }
          
          document.getElementById('modal-title').innerText = `"${preset.label}" সম্পাদনা করুন`;
          modal.classList.add('open');
        });

        const deleteBtn = document.createElement('button');
        deleteBtn.type = 'button';
        deleteBtn.className = 'preset-delete-btn';
        deleteBtn.innerHTML = '×';
        deleteBtn.title = 'প্রিসেট মুছুন';
        deleteBtn.addEventListener('click', async (e) => {
          e.stopPropagation();
          if (confirm(`আপনি কি "${preset.label}" প্রিসেটটি ডিলিট করতে চান?`)) {
            const res = await fetch(window.location.href, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'delete_preset', presetId: preset.id })
            });
            const data = await res.json();
            if (data.success) {
              currentPresets = currentPresets.filter(p => p.id !== preset.id);
              renderPresets();
            }
          }
        });

        chip.appendChild(labelBtn);
        chip.appendChild(editBtn);
        chip.appendChild(deleteBtn);
        parent.appendChild(chip);
      }
    });
  }

  // Handle Preset creation/editing actions
  const modal = document.getElementById('preset-modal');
  const btnCreatePreset = document.querySelectorAll('.btn-create-preset');
  const btnCloseModal = document.getElementById('btn-close-modal');
  const btnSaveModal = document.getElementById('btn-save-modal');
  
  let targetFieldType = 'content';

  function getFieldTypeLabel(type) {
    const labels = {
      content: 'ডিটেইলস কন্টেন্ট',
      ad_text: 'অ্যাড টেক্সট',
      app_banner: 'অ্যাপ ব্যানার'
    };
    return labels[type] || type;
  }

  btnCreatePreset.forEach(btn => {
    btn.addEventListener('click', () => {
      editingPresetId = null;
      targetFieldType = btn.getAttribute('data-field') || 'content';
      document.getElementById('modal-title').innerText = `${getFieldTypeLabel(targetFieldType)} এর জন্য নতুন প্রিসেট`;
      document.getElementById('preset-label').value = '';
      document.getElementById('preset-body').value = '';
      document.getElementById('preset-app-title').value = '';
      document.getElementById('preset-app-desc').value = '';
      document.getElementById('preset-app-btn').value = '';
      
      toggleBannerFields(targetFieldType === 'app_banner');
      modal.classList.add('open');
    });
  });

  if (btnCloseModal) {
    btnCloseModal.addEventListener('click', () => {
      modal.classList.remove('open');
      editingPresetId = null;
    });
  }

  if (btnSaveModal) {
    btnSaveModal.addEventListener('click', async () => {
      const label = document.getElementById('preset-label').value.trim();
      
      let body;
      if (targetFieldType === 'app_banner') {
        const title = document.getElementById('preset-app-title').value.trim();
        const description = document.getElementById('preset-app-desc').value.trim();
        const button_text = document.getElementById('preset-app-btn').value.trim();
        if (!label) {
          alert('দয়া করে প্রিসেটের নাম লিখুন।');
          return;
        }
        body = JSON.stringify({ title, description, button_text });
      } else {
        body = document.getElementById('preset-body').value;
        if (!label || !body) {
          alert('দয়া করে প্রিসেটের নাম ও কন্টেন্ট পূরণ করুন।');
          return;
        }
      }

      const action = editingPresetId ? 'update_preset' : 'save_preset';
      const payload = {
        action,
        field_type: targetFieldType,
        label,
        body
      };
      if (editingPresetId) payload.presetId = editingPresetId;

      const res = await fetch(window.location.href, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await res.json();
      if (data.success) {
        if (editingPresetId) {
          const idx = currentPresets.findIndex(p => p.id === editingPresetId);
          if (idx !== -1) currentPresets[idx] = data.preset;
        } else {
          currentPresets.push(data.preset);
        }
        renderPresets();
        modal.classList.remove('open');
        editingPresetId = null;
      } else {
        alert('প্রিসেট সংরক্ষণ করতে সমস্যা হয়েছে।');
      }
    });
  }

  // Initial load
  renderPresets();
</script>

