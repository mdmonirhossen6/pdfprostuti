<file path="src/pages/admin/login.astro">
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAdminCredentials, generateToken } from '../../utils/auth';

const runtime = Astro.locals.runtime;
let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const inputUser = data.get('username')?.toString().trim();
    const inputPass = data.get('password')?.toString();

    const { username, password, sessionSecret } = getAdminCredentials(runtime);

    if (inputUser === username && inputPass === password) {
      const token = await generateToken(username, password, sessionSecret);
      
      Astro.cookies.set('admin_token', token, {
        path: '/',
        httpOnly: true,
        secure: true,
        sameSite: 'strict',
        maxAge: 60 * 60 * 24 // 24 hours
      });

      return Astro.redirect('/admin');
    } else {
      errorMessage = 'ভুল ইউজারনেম অথবা পাসওয়ার্ড দেওয়া হয়েছে।';
    }
  } catch (e) {
    errorMessage = 'লগইন করার সময় একটি সমস্যা হয়েছে।';
  }
}
---

