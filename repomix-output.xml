---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { verifyAuth, getAdminCredentials } from '../../utils/auth';

const runtime = Astro.locals.runtime;
const isAuthed = await verifyAuth(Astro.cookies, runtime);

if (!isAuthed) {
  return Astro.redirect('/admin/login');
}

const { dbUrl, dbWriteKey, dbReadKey } = getAdminCredentials(runtime);
const { searchParams } = Astro.url;
const editId = searchParams.get('id');

let errorMessage = '';
let successMessage = '';

// Default structure
let postData = {
  title: '',
  slug: '',
  exam: 'HSC',
  subject: '',
  content: '',
  ad_text: '',
  image_url: '',
  file_url: '',
  drive_url: '',
  link_type: 'download',
  is_published: true,
  show_app_opener: true,
  app_link: '',
  app_title: '',
  app_description: '',
  app_button_text: ''
};

// Handle preset-save/delete actions sent via JSON POST
if (Astro.request.method === 'POST' && Astro.request.headers.get('content-type')?.includes('application/json')) {
  try {
    const jsonBody = await Astro.request.json();
    const { action, field_type, label, body, presetId } = jsonBody;

    if (action === 'save_preset') {
      const response = await fetch(`${dbUrl}/rest/v1/presets`, {
        method: 'POST',
        headers: {
          'apikey': dbWriteKey,
          'Authorization': `Bearer ${dbWriteKey}`,
          'Content-Type': 'application/json',
          'Prefer': 'return=representation'
        },
        body: JSON.stringify({ field_type, label, body })
      });
      if (response.ok) {
        const added = await response.json();
        return new Response(JSON.stringify({ success: true, preset: added[0] }), { status: 200 });
      }
    }

    if (action === 'delete_preset') {
      const response = await fetch(`${dbUrl}/rest/v1/presets?id=eq.${presetId}`, {
        method: 'DELETE',
        headers: {
          'apikey': dbWriteKey,
          'Authorization': `Bearer ${dbWriteKey}`
        }
      });
      if (response.ok) {
        return new Response(JSON.stringify({ success: true }), { status: 200 });
      }
    }

    if (action === 'update_preset') {
      const response = await fetch(`${dbUrl}/rest/v1/presets?id=eq.${presetId}`, {
        method: 'PATCH',
        headers: {
          'apikey': dbWriteKey,
          'Authorization': `Bearer ${dbWriteKey}`,
          'Content-Type': 'application/json',
          'Prefer': 'return=representation'
        },
        body: JSON.stringify({ field_type, label, body })
      });
      if (response.ok) {
        const updated = await response.json();
        return new Response(JSON.stringify({ success: true, preset: updated[0] }), { status: 200 });
      }
    }
  } catch (e) {
    return new Response(JSON.stringify({ success: false, message: 'Preset operation failed' }), { status: 500 });
  }
}

// Fetch existing post data if in Edit mode
if (editId) {
  try {
    const res = await fetch(`${dbUrl}/rest/v1/posts?id=eq.${editId}`, {
      headers: { 'apikey': dbReadKey, 'Authorization': `Bearer ${dbReadKey}` }
    });
    if (res.ok) {
      const data = await res.json();
      if (data && data.length > 0) {
        postData = data[0];
      }
    }
  } catch (e) {
    errorMessage = 'সংশ্লিষ্ট পোস্ট লোড করতে সমস্যা হয়েছে।';
  }
}

// Handle traditional Form submissions (Saving/Updating Posts)
if (Astro.request.method === 'POST' && !Astro.request.headers.get('content-type')?.includes('application/json')) {
  try {
    const data = await Astro.request.formData();
    
    const slugify = (value = '') => value
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .replace(/^-|-$/g, '');

    const payload = {
      title: data.get('title')?.toString().trim(),
      slug: slugify(data.get('slug')?.toString() || data.get('title')?.toString() || ''),
      exam: data.get('exam')?.toString().trim(),
      subject: slugify(data.get('subject')?.toString() || ''),
      content: data.get('content')?.toString(),
      ad_text: data.get('ad_text')?.toString(),
      image_url: data.get('image_url')?.toString().trim() || null,
      file_url: data.get('file_url')?.toString().trim() || null,
      drive_url: data.get('drive_url')?.toString().trim() || null,
      link_type: data.get('link_type')?.toString() || 'download',
      is_published: data.get('is_published') === 'true',
      show_app_opener: data.get('show_app_opener') === 'true',
      app_link: data.get('app_link')?.toString().trim() || null,
      app_title: data.get('app_title')?.toString().trim() || null,
      app_description: data.get('app_description')?.toString().trim() || null,
      app_button_text: data.get('app_button_text')?.toString().trim() || null
    };

    if (editId) {
      const updateRes = await fetch(`${dbUrl}/rest/v1/posts?id=eq.${editId}`, {
        method: 'PATCH',
        headers: {
          'apikey': dbWriteKey,
          'Authorization': `Bearer ${dbWriteKey}`,
          'Content-Type': 'application/json',
          'Prefer': 'return=representation'
        },
        body: JSON.stringify(payload)
      });

      if (updateRes.ok) {
        successMessage = 'পোস্টটি সফলভাবে আপডেট করা হয়েছে।';
        postData = payload;
      } else {
        const errJson = await updateRes.json().catch(() => ({}));
        errorMessage = `পোস্টটি আপডেট করতে ব্যর্থ হয়েছে: ${errJson.message || 'ডাটাবেজ কানেকশন সমস্যা'}`;
      }
    } else {
      const createRes = await fetch(`${dbUrl}/rest/v1/posts`, {
        method: 'POST',
        headers: {
          'apikey': dbWriteKey,
          'Authorization': `Bearer ${dbWriteKey}`,
          'Content-Type': 'application/json',
          'Prefer': 'return=representation'
        },
        body: JSON.stringify(payload)
      });

      if (createRes.ok) {
        return Astro.redirect('/admin?success=true');
      } else {
        const errJson = await createRes.json().catch(() => ({}));
        errorMessage = `নতুন পোস্ট সংরক্ষণ করতে ব্যর্থ হয়েছে: ${errJson.message || 'সম্ভবত এই স্ল্যাগটি (slug) ইতিমধ্যে ব্যবহার করা হয়েছে।'}`;
      }
    }
  } catch (e) {
    errorMessage = 'পোস্টটি সেভ করার সময় একটি ইরর হয়েছে।';
  }
}

// Fetch dynamic presets from Supabase
let databasePresets = [];
try {
  const presetRes = await fetch(`${dbUrl}/rest/v1/presets?order=created_at.asc`, {
    headers: { 'apikey': dbReadKey, 'Authorization': `Bearer ${dbReadKey}` }
  });
  if (presetRes.ok) {
    databasePresets = await presetRes.json();
  }
} catch (e) {
  console.error("Could not fetch database presets:", e);
}
