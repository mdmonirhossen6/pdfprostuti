---
import BaseLayout from '../layouts/BaseLayout.astro';

const { searchParams } = Astro.url;
const fileId = searchParams.get('id');

const dbUrl = import.meta.env.PUBLIC_SUPABASE_URL || 'https://your-supabase-project.supabase.co';
const apiKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || 'YOUR_SUPABASE_ANON_KEY';

let fileInfo = null;

try {
  const res = await fetch(`${dbUrl}/rest/v1/posts?id=eq.${fileId}`, {
    headers: { 'apikey': apiKey, 'Authorization': `Bearer ${apiKey}` }
  });
  if (res.ok) {
    const data = await res.json();
    fileInfo = data[0];
  }
} catch (e) {
  console.error("Error querying download file details:", e);
}

if (!fileInfo && fileId && fileId.startsWith('mock-')) {
  fileInfo = {
    id: fileId,
    title: "পদার্থবিজ্ঞান ১ম পত্র ১০০% কমন সাজেশন্স",
    file_url: "https://t.me/yourchannel",
    drive_url: "https://drive.google.com/open?id=mock",
    show_app_opener: true,
    app_link: null
  };
}

if (!fileInfo) {
  return Astro.redirect('/');
}

// Utility function to identify resource domains and labels
const getLinkDetails = (url) => {
  if (!url) return null;
  const isTelegram = url.includes('t.me') || url.includes('telegram.org');
  const isDrive = url.includes('drive.google.com') || url.includes('docs.google.com');
  const isDirectPdf = url.endsWith('.pdf');

  return {
    url,
    isTelegram,
    isDrive,
    isDirectPdf,
    label: isTelegram 
      ? "💬 টেলিগ্রাম থেকে ডাউনলোড করুন (প্রস্তাবিত)" 
      : isDrive 
