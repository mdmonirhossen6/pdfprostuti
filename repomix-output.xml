---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  exam?: string;
  subject?: string;
  slug?: string;
  publishDate?: string;
  keywords?: string;
}

const { title, description, exam, subject, slug, publishDate, keywords } = Astro.props;

const baseUrl = "https://prostutibd.app";
const normalizedExam = exam?.trim();
const normalizedSubject = subject?.trim();
const encodedSubject = normalizedSubject ? normalizedSubject.toLowerCase().replace(/\s+/g, '-') : '';
const canonicalUrl = normalizedExam && encodedSubject && slug
  ? `${baseUrl}/${normalizedExam.toLowerCase()}/${encodedSubject}/${slug}`
  : normalizedExam && slug
    ? `${baseUrl}/${normalizedExam.toLowerCase()}/${slug}`
    : baseUrl;
const siteName = "Prostuti BD";
const ogTitle = normalizedExam
  ? `${title} | ${normalizedExam} ${normalizedSubject || ''} | ${siteName}`
  : `${title} | ${siteName}`;
const ogDescription = description || (normalizedExam && normalizedSubject
  ? `Download ${title} PDF suggestion and notes for the ${normalizedExam} ${normalizedSubject} examination. Join our Telegram channel for the fastest updates.`
  : `Prostuti BD (প্রস্তুতি) - The ultimate preparation platform in Bangladesh. Download suggestions, model tests, resources and practice exams.`);
const pageKeywords = keywords || (normalizedExam && normalizedSubject
  ? `${title}, ${normalizedExam} ${normalizedSubject}, pdf download, suggestion, notes, model test`
  : `${title}, pdf download, preparation, Bangladesh, suggestion notes`);

// Define Schema.org Structured Data
const breadcrumbSchema = normalizedExam && slug ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": baseUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": normalizedExam.toUpperCase(),
      "item": `${baseUrl}/${normalizedExam.toLowerCase()}`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": canonicalUrl
    }
  ]
} : null;

const articleSchema = normalizedExam && slug ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "headline": ogTitle,
  "description": ogDescription,
  "image": "https://prostutibd.app/og-default.png",
  "datePublished": publishDate || new Date().toISOString(),
  "author": {
    "@type": "Organization",
    "name": "Prostuti BD",
    "url": baseUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": "Prostuti BD",
    "logo": {
      "@type": "ImageObject",
      "url": `${baseUrl}/favicon.svg`
    }
  }
} : {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "url": baseUrl,
  "name": siteName,
  "description": ogDescription,
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${baseUrl}/?search={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};
---

