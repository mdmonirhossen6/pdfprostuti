---
// filepath: src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDbCredentials } from '../utils/db';

const runtime = Astro.locals.runtime;
const { dbUrl, dbReadKey } = getDbCredentials(runtime);
const url = Astro.url;
const searchQuery = (url.searchParams.get('search') || '').trim();
const selectedCategory = (url.searchParams.get('category') || '').trim();
const selectedSubject = (url.searchParams.get('subject') || '').trim();

let posts = [];
try {
  const res = await fetch(`${dbUrl}/rest/v1/posts?is_published=eq.true&order=created_at.desc&limit=1000`, {
    headers: { 'apikey': dbReadKey, 'Authorization': `Bearer ${dbReadKey}` }
  });
  if (res.ok) {
    posts = await res.json();
  }
} catch (e) {
  console.error("Error fetching posts:", e);
}

const mockPosts = [
  {
    id: "mock-hsc-physics",
    title: "HSC 2026 পদার্থবিজ্ঞান প্রথম পত্র ১০০% কমন সাজেশন ও সমাধান",
    slug: "physics-1st-paper-suggestion",
    exam: "HSC",
    subject: "physics",
    content: "পরীক্ষার জন্য প্রয়োজনীয় সাজেশন, প্রশ্নব্যাংক, এবং গুরুত্বপূর্ণ অধ্যায়ের ডাউনলোড লিংক।",
    created_at: new Date().toISOString()
  },
  {
    id: "mock-bcs-bangla",
    title: "৪৬তম বিসিএস প্রিলিমিনারি বাংলা ভাষা ও সাহিত্য মডেল টেস্ট ও ব্যাখ্যা",
    slug: "bcs-46-bangla-literature",
    exam: "BCS",
    subject: "bangla",
    content: "বিসিএস প্রিলিমিনারি বাংলা ভাষা ও সাহিত্য থেকে গুরুত্বপূর্ণ প্রশ্ন ও ব্যাখ্যা।",
    created_at: new Date().toISOString()
  }
];

// Fetch site settings
let appUrl = 'https://web.prostutibd.app';
try {
  const settingsRes = await fetch(`${dbUrl}/rest/v1/site_settings?key=eq.app_url`, {
    headers: { 'apikey': dbReadKey, 'Authorization': `Bearer ${dbReadKey}` }
  });
  if (settingsRes.ok) {
    const rows = await settingsRes.json();
    if (rows && rows.length > 0 && rows[0].value) {
      appUrl = rows[0].value;
    }
  }
} catch (e) {
  console.error("Could not fetch app_url setting:", e);
}

const allPosts = posts && posts.length > 0 ? posts : mockPosts;
const normalizedSearch = searchQuery.toLowerCase();
const filteredPosts = allPosts.filter((post) => {
  const title = (post.title || '').toLowerCase();
  const subject = (post.subject || '').toLowerCase();
  const exam = (post.exam || '').toLowerCase();
  const content = (post.content || '').toLowerCase();
  const slug = (post.slug || '').toLowerCase();
  const searchMatches = !normalizedSearch || [title, subject, exam, content, slug].some((value) => value.includes(normalizedSearch));
  const categoryMatches = !selectedCategory || exam === selectedCategory.toLowerCase();
  const subjectMatches = !selectedSubject || subject === selectedSubject.toLowerCase();
  return searchMatches && categoryMatches && subjectMatches;
});

const featuredPosts = filteredPosts.slice(0, 6);
const recentPosts = filteredPosts.slice(6);
const categories = ["HSC", "SSC", "BCS", "Admission"];
const subjectOptions = [...new Set(allPosts.map((post) => post.subject).filter(Boolean))].sort();
const hasSearchOrFilter = Boolean(searchQuery || selectedCategory || selectedSubject);
---

<BaseLayout
  title="সেরা অনলাইন পরীক্ষা ও পিডিএফ সাজেশন"
  description="বাংলাদেশের সবচেয়ে জনপ্রিয় PDF সাজেশন, নোট, মডেল টেস্ট ও পরীক্ষার রিসোর্স খুঁজুন। HSC, SSC, BCS এবং Admission-এর জন্য ফ্রি ডাউনলোড করুন."
  keywords="pdf download, suggestion, notes, model test, hsc, ssc, bcs, admission"
>
  <div class="landing-page">
    <nav class="nav-bar">
      <div class="nav-container">
        <a href="/" class="logo">
          <span class="logo-icon">🎯</span>
          <span class="logo-text">প্রস্তুতি <span class="accent-text">BD</span></span>
        </a>
        <form class="nav-search" method="GET" action="/">
          <input
            type="search"
            name="search"
            value={searchQuery}
            placeholder="পিডিএফ, সাজেশন, বিষয় লিখুন..."
            aria-label="Search PDFs"
          />
          <button type="submit">🔎</button>
        </form>
        <div class="nav-links">
          <a href={appUrl} class="app-btn-nav" target="_blank">অ্যাপ ওপেন করুন</a>
        </div>
      </div>
    </nav>

    <header class="hero">
      <div class="hero-container">
        <h1 class="hero-title">বাংলাদেশের সেরা পরীক্ষা প্রস্তুতি ও সাজেশন প্ল্যাটফর্ম</h1>
        <p class="hero-subtitle">
          এইচএসসি, এসএসসি, বিসিএস এবং বিশ্ববিদ্যালয় ভর্তি পরীক্ষার জন্য প্রয়োজনীয় সকল সাজেশন্স, নোট এবং অধ্যায়ভিত্তিক মক টেস্ট দিন সম্পূর্ণ ফ্রিতে।
        </p>
        <div class="hero-ctas">
          <a href={appUrl} class="btn btn-primary pulse-animation" target="_blank">
            ⚡ লাইভ পরীক্ষা দিন (অ্যাপ)
          </a>
          <a href="#suggestions" class="btn btn-secondary">
            📚 পিডিএফ ডাউনলোড করুন
          </a>
        </div>
      </div>
    </header>

    <section class="search-panel">
      <div class="section-container search-panel-inner">
        <div>
          <p class="search-panel-label">PDF খুঁজুন</p>
          <h2>{hasSearchOrFilter ? 'ফিল্টার করা ফলাফল' : 'আপনার প্রয়োজনীয় PDF দ্রুত খুঁজুন'}</h2>
        </div>
        <form class="search-controls" method="GET" action="/">
          <input type="search" name="search" value={searchQuery} placeholder="পিডিএফ শিরোনাম বা বিষয় লিখুন" />
          <select name="category" aria-label="Filter by category">
            <option value="">সব ক্যাটাগরি</option>
            {categories.map((cat) => (
              <option value={cat.toLowerCase()} selected={selectedCategory === cat.toLowerCase()}>{cat}</option>
            ))}
          </select>
          <select name="subject" aria-label="Filter by subject">
            <option value="">সব বিষয়</option>
            {subjectOptions.map((subject) => (
              <option value={subject} selected={selectedSubject === subject}>{subject}</option>
            ))}
          </select>
          <button type="submit">ফিল্টার</button>
        </form>
      </div>
    </section>

    <section id="suggestions" class="suggestions-sec">
      <div class="section-container">
        <div class="sec-header">
          <h2 class="section-title">{hasSearchOrFilter ? 'ফিল্টার করা PDF ফলাফল' : 'সাম্প্রতিক সাজেশন ও পড়াশোনা ফাইলসমূহ'}</h2>
          <p class="sec-subtitle">
            {hasSearchOrFilter
              ? 'আপনার অনুসন্ধান ও ফিল্টার অনুযায়ী PDF গুলো এখানে দেখানো হচ্ছে।'
              : 'আপনার পরীক্ষার সিলেবাসের আলোকে সর্বশেষ পাবলিশ হওয়া ফাইলসমূহ ডাউনলোড করুন।'}
          </p>
        </div>

        {featuredPosts.length > 0 ? (
          <div class="suggestions-grid">
            {featuredPosts.map((post) => (
              <article class="glass-card suggestion-card">
                <div class="card-meta">
                  <span class="exam-tag">{post.exam}</span>
                  <span class="subject-tag">{post.subject}</span>
                </div>
                <h3 class="card-title">
                  <a href={`/${post.exam.toLowerCase()}/${post.subject.toLowerCase()}/${post.slug}`}>{post.title}</a>
                </h3>
                <p class="card-desc">
                  {(post.content || '').slice(0, 140)}{(post.content || '').length > 140 ? '...' : ''}
                </p>
                <div class="card-action">
                  <a href={`/${post.exam.toLowerCase()}/${post.subject.toLowerCase()}/${post.slug}`} class="card-btn">
                    বিস্তারিত দেখুন →
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="no-results">এই অনুসন্ধানে কোনো PDF পাওয়া যায়নি। অন্য কীওয়ার্ড বা ক্যাটাগরি ব্যবহার করে দেখুন।</div>
        )}

        {recentPosts.length > 0 && (
          <div class="more-results">
            <h3 class="section-title small-title">আরও PDF</h3>
            <div class="recent-list">
              {recentPosts.map((post) => (
                <a href={`/${post.exam.toLowerCase()}/${post.subject.toLowerCase()}/${post.slug}`} class="recent-item">
                  <span>{post.title}</span>
                  <span class="recent-meta">{post.exam} • {post.subject}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    <section class="features">
      <div class="section-container">
        <div class="features-grid">
          <div class="glass-card feature-card">
            <div class="feature-icon">🚀</div>
            <h3>গতিশীল ডাউনলোড</h3>
            <p>টেলিগ্রাম এবং গুগল ড্রাইভের মাধ্যমে কোনো ঝামেলা ছাড়াই সরাসরি হাই-স্পিড পিডিএফ ডাউনলোড করুন।</p>
          </div>
          <div class="glass-card feature-card">
            <div class="feature-icon">📝</div>
            <h3>অধ্যায়ভিত্তিক পরীক্ষা</h3>
            <p>আমাদের ইন্টারেক্টিভ ওয়েব অ্যাপে অধ্যায়ভিত্তিক কুইজ এবং রিয়েল-টাইম মক টেস্ট দেওয়ার সুবিধা।</p>
          </div>
          <div class="glass-card feature-card">
